# Generated by kiln [[ kiln_version ]] from .rn-forge/kiln/config.toml — do not edit; run 'kiln apply'
version: "3"

# The repo's Markdown, TOML and YAML formatting, checked and applied.
# Everything here is `internal: true`.

vars:
  # The files the formatters see: tracked and untracked, less what `.gitignore`
  # ignores. `git grep -e ''` lists only files present in the working tree, so a
  # deleted file is skipped. The `.git` guard stops a repo with none of its own
  # from listing an enclosing repository's files instead.
  FILES: >-
    { [ -e .git ] || { echo "not at a git repository's root" >&2; exit 1; }; };
    git grep --untracked -lz -e '' --

tasks:
  # Markdown is batched, twenty files to each of four processes; the formatters see disjoint files.
  lint:markdown:
    desc: Check that every Markdown file in the repo is mdformat-clean.
    internal: true
    cmds:
{% if overrides.get("quality:lint:markdown") %}      - [[ overrides["quality:lint:markdown"] ]]
{% else %}      - "{{.FILES}} '*.md' | xargs -0 -r -n 20 -P 4 uv run --group docs mdformat --check"
{% endif %}
  lint:toml:
    desc: Check that every TOML file in the repo is taplo-formatted.
    internal: true
    cmds:
{% if overrides.get("quality:lint:toml") %}      - [[ overrides["quality:lint:toml"] ]]
{% else %}      - "{{.FILES}} '*.toml' | xargs -0 -r uv run taplo fmt --check"
{% endif %}
  lint:yaml:
    desc: Check that every YAML file in the repo is formatted by google-yamlfmt.
    internal: true
    cmds:
{% if overrides.get("quality:lint:yaml") %}      - [[ overrides["quality:lint:yaml"] ]]
{% else %}      - "{{.FILES}} '*.yml' '*.yaml' | xargs -0 -r uv run yamlfmt -lint"
{% endif %}
  format:markdown:
    desc: Format every Markdown file in the repo with mdformat.
    internal: true
    cmds:
{% if overrides.get("quality:format:markdown") %}      - [[ overrides["quality:format:markdown"] ]]
{% else %}      - "{{.FILES}} '*.md' | xargs -0 -r -n 20 -P 4 uv run --group docs mdformat"
{% endif %}
  format:toml:
    desc: Format every TOML file in the repo with taplo.
    internal: true
    cmds:
{% if overrides.get("quality:format:toml") %}      - [[ overrides["quality:format:toml"] ]]
{% else %}      - "{{.FILES}} '*.toml' | xargs -0 -r uv run taplo fmt"
{% endif %}
  format:yaml:
    desc: Format every YAML file in the repo with google-yamlfmt.
    internal: true
    cmds:
{% if overrides.get("quality:format:yaml") %}      - [[ overrides["quality:format:yaml"] ]]
{% else %}      - "{{.FILES}} '*.yml' '*.yaml' | xargs -0 -r uv run yamlfmt"
{% endif -%}