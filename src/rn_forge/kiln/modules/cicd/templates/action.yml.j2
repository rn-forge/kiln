# Generated by kiln [[ kiln_version ]] from .rn-forge/kiln/config.toml — do not edit; run 'kiln apply'
{% if node_lib -%}
name: Setup
description: Install pnpm and Node, uv when the repository commits a uv.lock, optionally start an Nx Cloud CI run, and install dependencies. Run after actions/checkout.

inputs:
  start-ci-run:
    description: Arguments for `nx start-ci-run`; when empty, no Nx Cloud CI run is started
    required: false
    default: ''
  registry-url:
    description: npm registry URL passed to actions/setup-node (needed for npm OIDC publishing)
    required: false
    default: ''
  github-token:
    description: Token for setup-task's release lookup, to avoid rate limits.
    required: true

runs:
  using: composite
  steps:
    - uses: [[ pins["pnpm-setup"].uses ]]@[[ pins["pnpm-setup"].sha ]] # [[ pins["pnpm-setup"].version ]]
      with:
        run_install: false

    - if: ${{ inputs.start-ci-run != '' }}
      run: pnpm dlx nx start-ci-run ${{ inputs.start-ci-run }}
      shell: bash

    - uses: [[ pins["setup-node"].uses ]]@[[ pins["setup-node"].sha ]] # [[ pins["setup-node"].version ]]
      with:
        node-version-file: .nvmrc
        cache: pnpm
        registry-url: ${{ inputs.registry-url }}

    - run: pnpm install --frozen-lockfile
      shell: bash

    - if: ${{ hashFiles('**/uv.lock', '!**/node_modules/**') != '' }}
      uses: [[ pins["setup-uv"].uses ]]@[[ pins["setup-uv"].sha ]] # [[ pins["setup-uv"].version ]]
      with:
        version: 0.13.1
        enable-cache: true
        cache-dependency-glob: '**/uv.lock'

    - uses: [[ pins["setup-task"].uses ]]@[[ pins["setup-task"].sha ]] # [[ pins["setup-task"].version ]]
      with:
        version: 3.x
        repo-token: ${{ inputs.github-token }}
{% else %}name: Set up the toolchain
description: >-
  Install the pinned interpreter and go-task, and nothing else. Every CI job
  runs these steps right after its own checkout; a composite action is how
  they stay one copy instead of four. The checkout cannot live in here:
  GitHub resolves a local action from the checked-out tree.

inputs:
  github-token:
    description: Token for setup-task's release lookup, to avoid rate limits.
    required: true

runs:
  using: composite
  steps:
    - name: Install uv
      uses: [[ pins["setup-uv"].uses ]]@[[ pins["setup-uv"].sha ]] # [[ pins["setup-uv"].version ]]
      with:
        python-version: "3.14"
        enable-cache: true
        # The kiln pin lives in config.toml, so a pin change saves a fresh cache.
        cache-dependency-glob: |
          **/uv.lock
          .rn-forge/kiln/config.toml

    - name: Install go-task
      uses: [[ pins["setup-task"].uses ]]@[[ pins["setup-task"].sha ]] # [[ pins["setup-task"].version ]]
      with:
        version: 3.x
        repo-token: ${{ inputs.github-token }}
{% if web_app %}
    - name: Install pnpm
      uses: [[ pins["pnpm-setup"].uses ]]@[[ pins["pnpm-setup"].sha ]] # [[ pins["pnpm-setup"].version ]]

    - name: Install Node
      uses: [[ pins["setup-node"].uses ]]@[[ pins["setup-node"].sha ]] # [[ pins["setup-node"].version ]]
      with:
        cache: pnpm
{% endif %}{% endif %}{% for hook in hooks.setup %}
    - name: Run [[ hook ]]
      uses: [[ hook ]] # zizmor: ignore[self-repository] actionlint rejects the $/ form
{% endfor -%}
