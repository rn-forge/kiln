# Generated by kiln [[ kiln_version ]] from .rn-forge/kiln/config.toml — do not edit; run 'kiln apply'
version: "3"

# The internal implementation namespace: the lint/typecheck/test/format
# primitives the root wrappers compose. Everything here is `internal: true` —
# it exists to be called from a wrapper, not run directly.
{% if workspace %}#
# `python-lib` runs the per-package tools once per workspace member, from that
# member's own directory, so a package's ruff and pyright settings are the ones
# that apply to it. The repo-wide checkers — generated-file drift, imports, task
# layout, CI entrypoints, docs — run once, at the root, because that is the
# scope they describe.

vars:
  PACKAGES: [[ packages | join(" ") ]]
{% endif %}
tasks:
  lint:python:
{% if workspace %}    desc: Lint every workspace package with ruff, and check formatting.
{% elif web %}    desc: Lint the API package with ruff, and check formatting.
{% else %}    desc: Lint src/ and tests/ with ruff, and check formatting.
{% endif %}    internal: true
    cmds:
{% if overrides.get("quality:lint:python") %}      - [[ overrides["quality:lint:python"] ]]
{% elif workspace %}      - for: { var: PACKAGES, split: " " }
        cmd: uv run --directory packages/{{.ITEM}} --package {{.ITEM}} ruff check
      - for: { var: PACKAGES, split: " " }
        cmd: uv run --directory packages/{{.ITEM}} --package {{.ITEM}} ruff format --check
{% elif web %}      - uv run --directory [[ api_dir ]] --package [[ api_package ]] ruff check
      - uv run --directory [[ api_dir ]] --package [[ api_package ]] ruff format --check
{% else %}      - uv run ruff check src tests
      - uv run ruff format --check src tests
{% endif %}
  lint:markdown:
    desc: Check that every Markdown file in the tree is mdformat-clean.
    internal: true
    cmds:
{% if overrides.get("quality:lint:markdown") %}      - [[ overrides["quality:lint:markdown"] ]]
{% else %}      - uv run --group docs mdformat --check .
{% endif %}
  lint:generated:
    desc: Fail if a kiln-generated file or block has drifted from the committed state.
    internal: true
    cmds:
{% if overrides.get("quality:lint:generated") %}      - [[ overrides["quality:lint:generated"] ]]
{% else %}      - uv run kiln doctor . --only generated
{% endif %}
  lint:rn-forge-deps:
    desc: Enforce the archetype's rn-forge dependency contract — required, allowed, pinned.
    internal: true
    cmds:
{% if overrides.get("quality:lint:rn-forge-deps") %}      - [[ overrides["quality:lint:rn-forge-deps"] ]]
{% else %}      - uv run kiln doctor . --only rn-forge-deps
{% endif %}
  lint:imports:
    desc: Enforce the import-boundary contracts in .importlinter.
    internal: true
    cmds:
{% if overrides.get("quality:lint:imports") %}      - [[ overrides["quality:lint:imports"] ]]
{% else %}      - uv run lint-imports
{% endif %}
  lint:task-layout:
    desc: Enforce the wrapper/inner split, non-empty desc, and the validate gate.
    internal: true
    cmds:
{% if overrides.get("quality:lint:task-layout") %}      - [[ overrides["quality:lint:task-layout"] ]]
{% else %}      - uv run kiln doctor . --only task-layout
{% endif %}
  lint:ci-entrypoint:
    desc: Fail if a CI step invokes a wrapped tool instead of `task`.
    internal: true
    cmds:
{% if overrides.get("quality:lint:ci-entrypoint") %}      - [[ overrides["quality:lint:ci-entrypoint"] ]]
{% else %}      - uv run kiln doctor . --only ci-entrypoint
{% endif %}{% if docs %}
  lint:docs:
    desc: Check the docs site for broken links, bad anchors, and orphan pages.
    internal: true
    cmds:
{% if overrides.get("quality:lint:docs") %}      - [[ overrides["quality:lint:docs"] ]]
{% else %}      - uv run kiln doctor . --only docs-site
{% endif %}
  lint:docs-structure:
    desc: Check the docs tree matches the area model.
    internal: true
    cmds:
{% if overrides.get("quality:lint:docs-structure") %}      - [[ overrides["quality:lint:docs-structure"] ]]
{% else %}      - task: :docs:structure
{% endif %}
  lint:docs-nav:
    desc: Check mkdocs.yml's generated nav block is up to date.
    internal: true
    cmds:
{% if overrides.get("quality:lint:docs-nav") %}      - [[ overrides["quality:lint:docs-nav"] ]]
{% else %}      - uv run kiln doctor . --only docs-nav
{% endif %}{% endif %}
  format:python:
{% if workspace %}    desc: Fix and format every workspace package in place with ruff.
{% elif web %}    desc: Fix and format the API package in place with ruff.
{% else %}    desc: Fix and format src/ and tests/ in place with ruff.
{% endif %}    internal: true
    # `check --fix` first, then `format`: the linter's fixes are edits, and an
    # unused-import removal or a comprehension rewrite lands unformatted unless
    # the formatter runs after it. `lint:python` asserts the same pair in the
    # same order.
    cmds:
{% if overrides.get("quality:format:python") %}      - [[ overrides["quality:format:python"] ]]
{% elif workspace %}      - for: { var: PACKAGES, split: " " }
        cmd: uv run --directory packages/{{.ITEM}} --package {{.ITEM}} ruff check --fix
      - for: { var: PACKAGES, split: " " }
        cmd: uv run --directory packages/{{.ITEM}} --package {{.ITEM}} ruff format
{% elif web %}      - uv run --directory [[ api_dir ]] --package [[ api_package ]] ruff check --fix
      - uv run --directory [[ api_dir ]] --package [[ api_package ]] ruff format
{% else %}      - uv run ruff check --fix src tests
      - uv run ruff format src tests
{% endif %}
  format:markdown:
    desc: Format every Markdown file in the tree with mdformat.
    internal: true
    cmds:
{% if overrides.get("quality:format:markdown") %}      - [[ overrides["quality:format:markdown"] ]]
{% else %}      - uv run --group docs mdformat .
{% endif %}
  typecheck:python:
{% if workspace %}    desc: Type-check every workspace package with pyright in strict mode.
{% elif web %}    desc: Type-check the API package with pyright in strict mode.
{% else %}    desc: Type-check src/ with pyright in strict mode.
{% endif %}    internal: true
    cmds:
{% if overrides.get("quality:typecheck:python") %}      - [[ overrides["quality:typecheck:python"] ]]
{% elif workspace %}      - for: { var: PACKAGES, split: " " }
        cmd: uv run --directory packages/{{.ITEM}} --package {{.ITEM}} pyright src
{% elif web %}      - uv run --directory [[ api_dir ]] --package [[ api_package ]] pyright src
{% else %}      - uv run pyright src
{% endif %}
  test:python:
{% if workspace %}    desc: Run each workspace package's pytest suite.
{% elif web %}    desc: Run the API package's pytest suite.
{% else %}    desc: Run the pytest suite quietly.
{% endif %}    internal: true
    cmds:
{% if overrides.get("quality:test:python") %}      - [[ overrides["quality:test:python"] ]]
{% elif workspace %}      - for: { var: PACKAGES, split: " " }
        cmd: uv run --directory packages/{{.ITEM}} --package {{.ITEM}} pytest -q
{% elif web %}      - uv run --directory [[ api_dir ]] --package [[ api_package ]] pytest -q
{% else %}      - uv run pytest -q
{% endif %}
  test:coverage:
{% if workspace %}    desc: Run each package's tests with coverage, then combine into one XML report.
{% elif web %}    desc: Run the API package's tests with an XML coverage report for Sonar.
{% else %}    desc: Run the pytest suite with an XML coverage report for Sonar.
{% endif %}    internal: true
{% if workspace %}    # Coverage runs the way tests do — once per package, from that package's own
    # directory — so a member's pytest settings apply to its coverage run too.
    # Each run writes its own data file under the repo root (COVERAGE_FILE is
    # absolute, because the run's cwd is not the root), and `combine` merges
    # them. Paths stay absolute so Sonar can map a line back to
    # packages/<member>/src/... rather than to a `src/` that exists twice.
{% elif web %}    # Coverage runs from the API package's own directory, same as test:python, so
    # its pytest settings apply. `combine` is a single-file no-op here, kept for
    # the same reason the workspace form needs it: paths stay absolute so Sonar
    # maps a line back to [[ api_dir ]]/src/... rather than a `src/` that exists
    # under both the API and, for python-web-app, the frontend.
{% endif %}    cmds:
{% if overrides.get("quality:test:coverage") %}      - [[ overrides["quality:test:coverage"] ]]
{% elif workspace %}      - rm -f "{{.ROOT_DIR}}/.coverage" "{{.ROOT_DIR}}/.coverage."* coverage.xml
      - for: { var: PACKAGES, split: " " }
        cmd: >-
          COVERAGE_FILE="{{.ROOT_DIR}}/.coverage.{{.ITEM}}"
          uv run --directory packages/{{.ITEM}} --package {{.ITEM}}
          coverage run --rcfile "{{.ROOT_DIR}}/pyproject.toml" --source src -m pytest -q
      - uv run coverage combine
      - uv run coverage xml -o coverage.xml
{% elif web %}      - rm -f "{{.ROOT_DIR}}/.coverage" "{{.ROOT_DIR}}/.coverage."* coverage.xml
      - >-
          COVERAGE_FILE="{{.ROOT_DIR}}/.coverage.[[ api_package ]]"
          uv run --directory [[ api_dir ]] --package [[ api_package ]]
          coverage run --rcfile "{{.ROOT_DIR}}/pyproject.toml" --source src -m pytest -q
      - uv run coverage combine
      - uv run coverage xml -o coverage.xml
{% else %}      - uv run pytest -q --cov=[[ package ]] --cov-report=xml:coverage.xml
{% endif -%}
