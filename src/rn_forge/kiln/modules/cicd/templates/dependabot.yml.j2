# Generated by kiln [[ kiln_version ]] from .rn-forge/kiln/config.toml — do not edit; run 'kiln apply'
version: 2
updates:
{%- set directories = hooks.setup + (hooks.docs | reject("in", hooks.setup) | list) %}
{%- if directories %}
  - package-ecosystem: github-actions
    directories:
{%- for hook in directories %}
      - [[ hook[1:] ]]
{%- endfor %}
    schedule:
      interval: weekly
    cooldown:
      default-days: 7
    groups:
      github-actions:
        update-types: [minor, patch]
{%- endif %}
  - package-ecosystem: uv
    directory: /
    schedule:
      interval: weekly
    cooldown:
      default-days: 7
    groups:
      python:
        update-types: [minor, patch]
{%- if node %}
  - package-ecosystem: npm
    directory: /
    schedule:
      interval: weekly
    cooldown:
      default-days: 7
    groups:
      npm:
        update-types: [minor, patch]
{%- endif %}
