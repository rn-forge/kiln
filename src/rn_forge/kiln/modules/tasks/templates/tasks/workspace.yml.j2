# Generated by kiln [[ kiln_version ]] from .rn-forge/kiln/config.toml — do not edit; run 'kiln apply'
version: "3"

# Everything that acts on the workspace as a whole: dependency sync, packaging,
# the version read, and cleanup. Internal — reached through the root wrappers.
{% if workspace %}#
# `build` and `version` take an optional package name (`task build -- golden-alpha`).
# CI passes one per matrix leg, because a `python-lib` repo releases per package
# under a `<package>-v<version>` tag; a developer passes none and gets all of them.

vars:
  PACKAGES: [[ packages | join(" ") ]]
{% endif %}
tasks:
  install:
{% if workspace %}    desc: Sync the whole workspace with the dev and docs dependency groups.
{% else %}    desc: Sync the virtualenv with the dev and docs dependency groups.
{% endif %}    internal: true
    cmds:
{% if overrides.get("workspace:install") %}      - [[ overrides["workspace:install"] ]]
{% elif workspace %}      - uv sync --all-packages --group dev --group docs
{% else %}      - uv sync --group dev --group docs
{% endif %}
  version:
{% if workspace %}    desc: Print one package's version, or every package's when given no argument.
{% else %}    desc: Print the package version from pyproject.toml.
{% endif %}    internal: true
    silent: true
    cmds:
{% if overrides.get("workspace:version") %}      - [[ overrides["workspace:version"] ]]
{% elif workspace %}      - |
        if [ -n "{{.CLI_ARGS}}" ]; then
          uv version --short --package "{{.CLI_ARGS}}"
        else
          for package in {{.PACKAGES}}; do
            printf '%s %s\n' "$package" "$(uv version --short --package "$package")"
          done
        fi
{% else %}      - uv version --short
{% endif %}
  build:
{% if workspace %}    desc: Build one package's wheel and sdist into dist/, or every package's.
{% else %}    desc: Build the wheel and sdist into dist/.
{% endif %}    internal: true
    env:
      # Packaging must not reuse the in-repo cache — `uv build` resolves against
      # a clean tree, and a shared cache has historically leaked stale metadata.
      UV_CACHE_DIR: /tmp/[[ name ]]-uv-cache
    cmds:
{% if overrides.get("workspace:build") %}      - [[ overrides["workspace:build"] ]]
{% elif workspace %}      - |
        for package in {{.CLI_ARGS | default .PACKAGES}}; do
          uv build --package "$package" --out-dir dist
        done
{% else %}      - uv build
{% endif %}
  clean:
    desc: Remove build outputs, tool caches, and the rendered docs site.
    internal: true
    cmds:
{% if overrides.get("workspace:clean") %}      - [[ overrides["workspace:clean"] ]]
{% else %}      - rm -rf dist build [[ site_dir ]] .pytest_cache .ruff_cache .uv-cache .import_linter_cache coverage.xml
      - find . -type d -name __pycache__ -not -path './.venv/*' -exec rm -rf {} +
{% endif -%}
