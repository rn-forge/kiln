{% endfor %}
  # The only check branch protection requires. Job and matrix names change as
  # the repo grows; this one does not. A skipped job (the fork-guarded scan, a
  # release on a pull request) is not a failure.
  ci-ok:
    needs: [validate, dependency-review{% if workspace %}, plan, verify, postgres, smoke, suites{% endif %}{% if sonar %}, sonar{% endif %}{% if release == "tag-exists" %}, release{% if workspace %}, external-install{% endif %}{% endif %}{% if workspace and docs %}, docs{% endif %}{% for job in jobs %}, [[ job.name ]]{% endfor %}]
    if: always()
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions: {}
    steps:
      - name: Every job passed or was skipped
        if: contains(needs.*.result, 'failure') || contains(needs.*.result, 'cancelled')
        run: exit 1
