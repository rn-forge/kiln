# Generated by kiln [[ kiln_version ]] from .rn-forge/kiln/config.toml — do not edit; run 'kiln apply'
name: Scorecard

# OpenSSF Scorecard for a public repository. It reports to Code scanning and
# does not gate a merge, so ci-ok does not wait for it.

on:
  schedule:
    - cron: '17 4 * * 1'
  workflow_dispatch: {}

permissions:
  contents: read

jobs:
  analysis:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: read
      actions: read
      id-token: write
      security-events: write
    steps:
      - name: Checkout
        uses: [[ pins["checkout"].uses ]]@[[ pins["checkout"].sha ]] # [[ pins["checkout"].version ]]
        with:
          persist-credentials: false

      - name: Run Scorecard
        uses: [[ pins["scorecard"].uses ]]@[[ pins["scorecard"].sha ]] # [[ pins["scorecard"].version ]]
        with:
          results_file: results.sarif
          results_format: sarif
          publish_results: true

      - name: Upload results to Code scanning
        uses: [[ pins["upload-sarif"].uses ]]@[[ pins["upload-sarif"].sha ]] # [[ pins["upload-sarif"].version ]]
        with:
          sarif_file: results.sarif
