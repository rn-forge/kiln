# Generated by kiln [[ kiln_version ]] from .rn-forge/kiln/config.toml — do not edit; run 'kiln apply'
name: CI

{% if workspace %}# validate → sonar → release (a matrix over the workspace members).
#
# The verify half is not a matrix: the workspace is resolved and gated once,
# which is also what a developer runs. The release half is, because a python-lib
# repo publishes each package on its own `<package>-v<version>` tag.
{% else %}# validate → sonar → release.
{% endif %}#
# Every step goes through `task`; `kiln doctor`'s ci-entrypoint rule fails the
# build if a step invokes uv/pytest/ruff/pyright/mkdocs/kiln directly. kiln is
# not installed here and never will be: what CI checks is the committed
# .rn-forge/kiln/state.json baseline, through `task validate` (kiln ADR-0003).
#
# The repeated toolchain setup lives in .github/actions/setup, committed beside
# this file. Every `uses:` is pinned to a commit SHA with the version in a
# trailing comment; Dependabot watches kiln's own repo, not this file (D21).

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
  workflow_dispatch: {}

permissions:
  contents: read

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

env:
  # CI resolves the committed lock and never rewrites it. Without this a stale
  # uv.lock passes CI against a resolution nobody committed.
  UV_LOCKED: "1"

jobs:
  validate:
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - name: Set up the toolchain
        uses: ./.github/actions/setup
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}

      - name: Install dependencies
        run: task setup

      - name: Validate
        run: task validate
{% if sonar %}
  sonar:
    needs: validate
    # A fork's pull request cannot see SONAR_TOKEN, so an unconditional scan job
    # fails on every external contribution. Validation stays required; the scan
    # is skipped where its credential cannot exist.
    if: >-
      github.event_name != 'pull_request' ||
      github.event.pull_request.head.repo.full_name == github.repository
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pull-requests: read
    steps:
      - name: Set up the toolchain
        uses: ./.github/actions/setup
        with:
          fetch-depth: "0"
          github-token: ${{ secrets.GITHUB_TOKEN }}

      - name: Install dependencies
        run: task setup

      - name: Test with coverage
        run: task test:coverage

      # `sonar.qualitygate.wait` is what makes the gate a gate: without it the
      # job succeeds on *submitting* the analysis, and a release can ship while
      # Sonar is still deciding it failed.
      - name: SonarQube scan
        uses: [[ pins["sonarqube-scan"].uses ]]@[[ pins["sonarqube-scan"].sha ]] # [[ pins["sonarqube-scan"].version ]]
        env:
          SONAR_TOKEN: ${{ secrets.SONAR_TOKEN }}
        with:
          args: -Dsonar.qualitygate.wait=true
{% endif %}{% if release == "tag-exists" %}
  release:
    needs: [validate{% if sonar %}, sonar{% endif %}]
    if: github.event_name == 'push' && github.ref_name == 'main'
    runs-on: ubuntu-latest
    permissions:
      contents: write
{% if workspace %}    strategy:
      # One package's release failing must not cancel another's — they are
      # independent distributions that happen to share a repository.
      fail-fast: false
      matrix:
        package: [{% for package in packages %}[[ package ]]{% if not loop.last %}, {% endif %}{% endfor %}]
{% endif %}    steps:
      - name: Set up the toolchain
        uses: ./.github/actions/setup
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}

      - name: Read version
        id: version
        run: |
          version="$(task version{% if workspace %} -- ${{ matrix.package }}{% endif %})"
          printf 'version=%s\n' "$version" >> "$GITHUB_OUTPUT"

      # The *release* is the record of what shipped, not the tag (D22). Checking
      # the tag instead would make a half-finished publish permanent: the tag
      # would exist, the release would not, and every rerun would skip.
      - name: Check whether this version has been released
        id: check
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          tag="{% if workspace %}${{ matrix.package }}-{% endif %}v${{ steps.version.outputs.version }}"
          if gh release view "$tag" --json isDraft --jq '.isDraft == false' 2>/dev/null | grep -q true; then
            printf '%s\n' "Release $tag already published; nothing to do."
            printf 'should-release=false\n' >> "$GITHUB_OUTPUT"
          else
            printf 'should-release=true\n' >> "$GITHUB_OUTPUT"
          fi

      - name: Build
        if: steps.check.outputs.should-release == 'true'
        run: task build{% if workspace %} -- ${{ matrix.package }}{% endif %}

      # action-gh-release creates the tag itself from `tag_name`, at this commit,
      # as part of publishing. Tagging in a separate earlier step is what made a
      # failed upload unrecoverable.
      - name: Publish GitHub Release
        if: steps.check.outputs.should-release == 'true'
        uses: [[ pins["gh-release"].uses ]]@[[ pins["gh-release"].sha ]] # [[ pins["gh-release"].version ]]
        with:
          tag_name: {% if workspace %}${{ matrix.package }}-{% endif %}v${{ steps.version.outputs.version }}
          target_commitish: ${{ github.sha }}
          name: {% if workspace %}${{ matrix.package }} {% endif %}v${{ steps.version.outputs.version }}
          generate_release_notes: true
          files: dist/*
{% endif %}