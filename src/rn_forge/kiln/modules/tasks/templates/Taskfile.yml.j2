# Generated by kiln [[ kiln_version ]] from .rn-forge/kiln/config.toml — do not edit; run 'kiln apply'
version: "3"

# The only entrypoint. Nobody — human, agent or CI — invokes `uv`, `pytest`,
# `ruff`, `pyright`, `mkdocs` or `kiln` directly; `kiln doctor`'s `ci-entrypoint`
# check enforces that for every workflow file.
#
# This file holds wrappers only: every task below is a list of calls into
# tasks/*.yml. Anything that shells out lives in the namespace file that owns
# it. Namespaces whose public name is already correct (docs:*) are reached
# through the include directly and carry no wrapper here.
#
# The vocabulary is fixed; see .rn-forge/kiln/standard.md.

env:
  # Keeping the uv cache inside the repo avoids competing with other checkouts
  # for a shared cache dir. Tasks that must not share it (packaging) override
  # this locally.
  UV_CACHE_DIR: .uv-cache

includes:
  quality: tasks/quality.yml
  python: tasks/python.yml
  kiln: tasks/kiln.yml
{% if docs %}  docs: tasks/docs.yml
{% endif %}  workspace: tasks/workspace.yml
  ci: tasks/ci.yml
{% if web %}  api: tasks/api.yml
{% endif %}{% if web_app %}  web: tasks/web.yml
{% endif %}{% if node %}  node: tasks/node.yml
{% endif %}{% for include in includes %}  [[ include.namespace ]]: [[ include.taskfile ]]
{% endfor %}
tasks:
  setup:
    desc: {% if node_lib %}Install the pnpm workspace and the docs tooling.{% else %}Install the project and its dev + docs dependency groups.{% endif %}
    cmds:
      - task: python:install
{% if node %}      - task: node:install
{% endif %}{% for ref in extra_refs.get("setup", []) %}      - task: [[ ref ]]
{% endfor %}
  validate:
    desc: The aggregate gate — lint, typecheck, test, docs build. Any failure fails.
    cmds:
      - task: lint
      - task: typecheck
      - task: test
{% if docs %}      - task: docs:build
{% endif %}{% for ref in extra_refs.get("validate", []) %}      - task: [[ ref ]]
{% endfor %}
  lint:
    desc: {% if node_lib %}Every lint — Nx projects, Markdown and TOML formatting, kiln's checks, workflow security.{% else %}Every lint — Python, imports, Markdown and TOML formatting, kiln's checks (generated files, task layout, CI, dependencies, docs), workflow security, dependency vulnerabilities.{% endif %}
    cmds:
{% if not node_lib %}      - task: python:lint
      - task: python:lint:imports
{% endif %}{% if node %}      - task: node:lint
{% endif %}      - task: quality:lint:markdown
      - task: quality:lint:toml
      - task: kiln:doctor
      - task: ci:lint:workflows
{% if not node_lib %}      - task: python:lint:audit
{% endif %}{% for ref in extra_refs.get("lint", []) %}      - task: [[ ref ]]
{% endfor %}
  format:
    desc: {% if node_lib %}Format TOML and Markdown prose in place.{% else %}Format Python code, TOML and Markdown prose in place.{% endif %}
    cmds:
{% if not node_lib %}      - task: python:format
{% endif %}      - task: quality:format:markdown
      - task: quality:format:toml
{% for ref in extra_refs.get("format", []) %}      - task: [[ ref ]]
{% endfor %}
  typecheck:
    desc: {% if node_lib %}Type-check every project through its Angular build.{% elif web_app %}Type-check the API in pyright strict mode and the frontend through its Angular build.{% else %}Static type-check the package in pyright strict mode.{% endif %}
    cmds:
{% if not node_lib %}      - task: python:typecheck
{% endif %}{% if node %}      - task: node:typecheck
{% endif %}{% for ref in extra_refs.get("typecheck", []) %}      - task: [[ ref ]]
{% endfor %}
  test:
    desc: {% if node_lib %}Run every project's tests with Nx.{% elif web_app %}Run the API's pytest suite and the frontend's tests.{% else %}Run the pytest suite.{% endif %}
    cmds:
{% if not node_lib %}      - task: python:test
{% endif %}{% if node %}      - task: node:test
{% endif %}{% for ref in extra_refs.get("test", []) %}      - task: [[ ref ]]
{% endfor %}
  test:coverage:
    desc: {% if node_lib %}Run every project's tests, writing lcov reports to coverage/.{% elif web_app %}Run both test suites with coverage reports (used by CI/Sonar).{% else %}Run the pytest suite with an XML coverage report (used by CI/Sonar).{% endif %}
    cmds:
{% if not node_lib %}      - task: python:test:coverage
{% endif %}{% if node %}      - task: node:test
{% endif %}{% for ref in extra_refs.get("test:coverage", []) %}      - task: [[ ref ]]
{% endfor %}
  build:
{% if workspace %}    desc: Build one package's wheel and sdist into dist/ (pass -- <package>), or every package's.
{% elif node_lib %}    desc: Build every project with Nx.
{% elif web_app %}    desc: Build the API's wheel and sdist, and the frontend.
{% else %}    desc: Build the wheel and sdist into dist/.
{% endif %}    cmds:
{% if not node_lib %}      - task: python:build
{% endif %}{% if node %}      - task: node:build
{% endif %}{% for ref in extra_refs.get("build", []) %}      - task: [[ ref ]]
{% endfor %}
  version:
{% if workspace %}    desc: Print one package's version (pass -- <package>), or every package's.
{% elif node_lib %}    desc: Print the root pyproject.toml's version.
{% else %}    desc: Print the package version from pyproject.toml.
{% endif %}    cmds:
      - task: python:version
{% for ref in extra_refs.get("version", []) %}      - task: [[ ref ]]
{% endfor %}
  clean:
    desc: Remove build outputs, caches, and the rendered docs site.
    cmds:
      - task: workspace:clean
{% for ref in extra_refs.get("clean", []) %}      - task: [[ ref ]]
{% endfor -%}
