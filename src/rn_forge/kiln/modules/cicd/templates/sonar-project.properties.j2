# Generated by kiln [[ kiln_version ]] from .rn-forge/kiln/config.toml — do not edit; run 'kiln apply'
sonar.projectKey=rn-forge_[[ name ]]
sonar.projectName=[[ name ]]
sonar.organization=[[ organization ]]

{% if web %}sonar.sources=[[ api_dir ]]/src{% if web_app %},[[ web_dir ]]/src{% endif %}
sonar.tests=[[ api_dir ]]/tests
{% elif workspace %}sonar.sources={% for package in packages %}packages/[[ package ]]/src{% if not loop.last %},{% endif %}{% endfor %}
sonar.tests={% for package in packages %}packages/[[ package ]]/tests{% if not loop.last %},{% endif %}{% endfor %}
{% else %}sonar.sources=src
sonar.tests=tests
{% endif %}
sonar.python.version=3.14
sonar.python.coverage.reportPaths=coverage.xml
