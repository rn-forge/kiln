#!/usr/bin/env node
// Generated by kiln [[ kiln_version ]] from .rn-forge/kiln/config.toml — do not edit; run 'kiln apply'
/**
 * Prints the section of `CHANGELOG.md` (read from the current directory) whose
 * `## ` heading contains `<version>` as a whole token, from that heading up to
 * (not including) the next `## ` heading, with surrounding blank lines trimmed.
 * `0.1.2` does not match `0.1.20` or `10.1.2`. Exits non-zero when no section
 * matches or no version is given.
 *
 * Usage: node release-notes.mjs <version>
 */
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

const [, , version] = process.argv;
if (!version) {
  console.error('Usage: node release-notes.mjs <version>');
  process.exit(1);
}

const changelogPath = join(process.cwd(), 'CHANGELOG.md');
let changelog;
try {
  changelog = readFileSync(changelogPath, 'utf-8');
} catch (err) {
  console.error(`Could not read ${changelogPath} (${err.message})`);
  process.exit(1);
}

const escaped = version.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const token = new RegExp(`(^|[^0-9.])${escaped}([^0-9.]|$)`);

const lines = changelog.split(/\r?\n/);
const start = lines.findIndex(
  (line) => line.startsWith('## ') && token.test(line),
);
if (start === -1) {
  console.error(`No section for version ${version} in ${changelogPath}`);
  process.exit(1);
}

let end = lines.findIndex((line, i) => i > start && line.startsWith('## '));
if (end === -1) end = lines.length;

console.log(lines.slice(start, end).join('\n').trim());
