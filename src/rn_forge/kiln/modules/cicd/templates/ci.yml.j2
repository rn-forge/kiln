{% endif %}{% for job in jobs %}
  [[ job.name ]]:
    needs: validate
{% if job.events | length < 3 %}    if: ${{ {% for event in job.events %}github.event_name == '[[ event ]]'{% if not loop.last %} || {% endif %}{% endfor %} }}
{% endif %}    permissions:
      contents: read
