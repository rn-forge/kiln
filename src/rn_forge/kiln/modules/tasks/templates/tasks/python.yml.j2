# Generated by kiln [[ kiln_version ]] from .rn-forge/kiln/config.toml — do not edit; run 'kiln apply'
version: "3"

# The internal implementation namespace: the uv toolchain the root wrappers
# compose. Everything here is `internal: true` — it exists to be called from a
# wrapper, not run directly.
{% if workspace %}#
# `python-lib` runs the per-package tools once per workspace member, from that
# member's own directory, so a package's ruff and pyright settings are the ones
# that apply to it. The repo-wide checkers — generated-file drift, imports, task
# layout, CI entrypoints, docs — run once, at the root, because that is the
# scope they describe.
#
# `build` and `version` take an optional package name (`task build -- golden-alpha`).
# CI passes one per matrix leg, because a `python-lib` repo releases per package
# under a `<package>-v<version>` tag; a developer passes none and gets all of them.

vars:
  PACKAGE_DIRS: [[ package_dirs | join(" ") ]]
  PACKAGES: [[ packages | join(" ") ]]
{% endif %}
tasks:
  install:
{% if workspace %}    desc: Sync the whole workspace with the dev and docs dependency groups.
{% elif web %}    desc: Sync the workspace with the dev and docs dependency groups.
{% else %}    desc: Sync the virtualenv with the dev and docs dependency groups.
{% endif %}    internal: true
    cmds:
{% if overrides.get("python:install") %}      - [[ overrides["python:install"] ]]
{% elif workspace %}      - uv sync --all-packages --group dev --group docs
{% elif web %}      - uv sync --all-packages --group dev --group docs
{% else %}      - uv sync --group dev --group docs
{% endif %}
  lint:
{% if workspace %}    desc: Lint every workspace package with ruff, and check formatting.
{% elif web %}    desc: Lint the API package with ruff, and check formatting.
{% else %}    desc: Lint src/ (and tests/, when present) with ruff, and check formatting.
{% endif %}    internal: true
    cmds:
{% if overrides.get("python:lint") %}      - [[ overrides["python:lint"] ]]
{% elif workspace and not packages %}      - echo "no packages to check; add one with 'kiln generate package <name>'"
{% elif workspace %}      - for: { var: PACKAGE_DIRS, split: " " }
        cmd: uv run --directory {{.ITEM}} --package {{base .ITEM}} ruff check src $(test -d {{.ITEM}}/tests && echo tests)
      - for: { var: PACKAGE_DIRS, split: " " }
        cmd: uv run --directory {{.ITEM}} --package {{base .ITEM}} ruff format --check src $(test -d {{.ITEM}}/tests && echo tests)
{% elif web %}      - uv run --directory [[ api_dir ]] --package [[ api_package ]] ruff check src $(test -d [[ api_dir ]]/tests && echo tests)
      - uv run --directory [[ api_dir ]] --package [[ api_package ]] ruff format --check src $(test -d [[ api_dir ]]/tests && echo tests)
{% else %}      - uv run ruff check src $(test -d tests && echo tests)
      - uv run ruff format --check src $(test -d tests && echo tests)
{% endif %}
  lint:imports:
    desc: Enforce the import-boundary contracts in .importlinter.
    internal: true
    cmds:
{% if overrides.get("python:lint:imports") %}      - [[ overrides["python:lint:imports"] ]]
{% elif workspace and not packages %}      - echo "no packages to check; add one with 'kiln generate package <name>'"
{% else %}      - uv run lint-imports
{% endif %}
  lint:audit:
    desc: Fail if a locked dependency has a known vulnerability (pip-audit; needs the network).
    internal: true
    # `set -o pipefail`: go-task's shell takes only the last command's status
    # from a pipeline, so a failing `uv export` would otherwise audit nothing
    # and pass.
    cmds:
{% if overrides.get("python:lint:audit") %}      - [[ overrides["python:lint:audit"] ]]
{% else %}      - >-
        set -o pipefail;
        uv export --frozen --all-packages --all-groups --no-emit-workspace --no-header
{% for name in audit_excluded %}        --no-emit-package [[ name ]]
{% endfor %}        | uv run pip-audit --disable-pip --require-hashes --strict -r /dev/stdin
{% for id in audit_ignore %}        --ignore-vuln [[ id ]]
{% endfor %}{% endif %}
  format:
{% if workspace %}    desc: Fix and format every workspace package in place with ruff.
{% elif web %}    desc: Fix and format the API package in place with ruff.
{% else %}    desc: Fix and format src/ (and tests/, when present) in place with ruff.
{% endif %}    internal: true
    # `check --fix` first, then `format`: the linter's fixes are edits, and an
    # unused-import removal or a comprehension rewrite lands unformatted unless
    # the formatter runs after it. `lint` asserts the same pair in the
    # same order.
    cmds:
{% if overrides.get("python:format") %}      - [[ overrides["python:format"] ]]
{% elif workspace and not packages %}      - echo "no packages to check; add one with 'kiln generate package <name>'"
{% elif workspace %}      - for: { var: PACKAGE_DIRS, split: " " }
        cmd: uv run --directory {{.ITEM}} --package {{base .ITEM}} ruff check --fix src $(test -d {{.ITEM}}/tests && echo tests)
      - for: { var: PACKAGE_DIRS, split: " " }
        cmd: uv run --directory {{.ITEM}} --package {{base .ITEM}} ruff format src $(test -d {{.ITEM}}/tests && echo tests)
{% elif web %}      - uv run --directory [[ api_dir ]] --package [[ api_package ]] ruff check --fix src $(test -d [[ api_dir ]]/tests && echo tests)
      - uv run --directory [[ api_dir ]] --package [[ api_package ]] ruff format src $(test -d [[ api_dir ]]/tests && echo tests)
{% else %}      - uv run ruff check --fix src $(test -d tests && echo tests)
      - uv run ruff format src $(test -d tests && echo tests)
{% endif %}
  typecheck:
{% if workspace %}    desc: Type-check every workspace package with pyright in strict mode.
{% elif web %}    desc: Type-check the API package with pyright in strict mode.
{% else %}    desc: Type-check src/ with pyright in strict mode.
{% endif %}    internal: true
    cmds:
{% if overrides.get("python:typecheck") %}      - [[ overrides["python:typecheck"] ]]
{% elif workspace and not packages %}      - echo "no packages to check; add one with 'kiln generate package <name>'"
{% elif workspace %}      - for: { var: PACKAGE_DIRS, split: " " }
        cmd: uv run --directory {{.ITEM}} --package {{base .ITEM}} pyright src
{% elif web %}      - uv run --directory [[ api_dir ]] --package [[ api_package ]] pyright src
{% else %}      - uv run pyright src
{% endif %}
  test:
{% if workspace %}    desc: Run each workspace package's pytest suite.
{% elif web %}    desc: Run the API package's pytest suite.
{% else %}    desc: Run the pytest suite quietly.
{% endif %}    internal: true
    cmds:
{% if overrides.get("python:test") %}      - [[ overrides["python:test"] ]]
{% elif workspace and not packages %}      - echo "no packages to check; add one with 'kiln generate package <name>'"
{% elif workspace %}      - for: { var: PACKAGE_DIRS, split: " " }
        cmd: uv run --directory {{.ITEM}} --package {{base .ITEM}} pytest -q
{% elif web %}      - uv run --directory [[ api_dir ]] --package [[ api_package ]] pytest -q
{% else %}      - uv run pytest -q
{% endif %}
  test:coverage:
{% if workspace %}    desc: Run each package's tests with coverage, then combine into one XML report.
{% elif web %}    desc: Run the API package's tests with an XML coverage report for Sonar.
{% else %}    desc: Run the pytest suite with an XML coverage report for Sonar.
{% endif %}    internal: true
{% if workspace %}    # Coverage runs the way tests do — once per package, from that package's own
    # directory — so a member's pytest settings apply to its coverage run too.
    # Each run writes its own data file under the repo root (COVERAGE_FILE is
    # absolute, because the run's cwd is not the root), and `combine` merges
    # them. Paths stay absolute so Sonar can map a line back to
    # packages/<member>/src/... rather than to a `src/` that exists twice.
{% elif web %}    # Coverage runs from the API package's own directory, same as test, so
    # its pytest settings apply. `combine` is a single-file no-op here, kept for
    # the same reason the workspace form needs it: paths stay absolute so Sonar
    # maps a line back to [[ api_dir ]]/src/... rather than a `src/` that exists
    # under both the API and, for python-web-app, the frontend.
{% endif %}    cmds:
{% if overrides.get("python:test:coverage") %}      - [[ overrides["python:test:coverage"] ]]
{% elif workspace and not packages %}      - echo "no packages to check; add one with 'kiln generate package <name>'"
{% elif workspace %}      - rm -f "{{.ROOT_DIR}}/.coverage" "{{.ROOT_DIR}}/.coverage."* coverage.xml
      - for: { var: PACKAGE_DIRS, split: " " }
        cmd: >-
          COVERAGE_FILE="{{.ROOT_DIR}}/.coverage.{{base .ITEM}}"
          uv run --directory {{.ITEM}} --package {{base .ITEM}}
          coverage run --rcfile "{{.ROOT_DIR}}/pyproject.toml" --source src -m pytest -q
      - uv run coverage combine
      - uv run coverage xml -o coverage.xml
{% elif web %}      - rm -f "{{.ROOT_DIR}}/.coverage" "{{.ROOT_DIR}}/.coverage."* coverage.xml
      - >-
          COVERAGE_FILE="{{.ROOT_DIR}}/.coverage.[[ api_package ]]"
          uv run --directory [[ api_dir ]] --package [[ api_package ]]
          coverage run --rcfile "{{.ROOT_DIR}}/pyproject.toml" --source src -m pytest -q
      - uv run coverage combine
      - uv run coverage xml -o coverage.xml
{% else %}      - uv run pytest -q --cov=[[ package ]] --cov-report=xml:coverage.xml
{% endif %}
  build:
{% if workspace %}    desc: Build one package's wheel and sdist into dist/, or every package's.
{% elif web %}    desc: Build the API package's wheel and sdist into dist/.
{% else %}    desc: Build the wheel and sdist into dist/.
{% endif %}    internal: true
    env:
      # Packaging must not reuse the in-repo cache — `uv build` resolves against
      # a clean tree, and a shared cache has historically leaked stale metadata.
      UV_CACHE_DIR: /tmp/[[ name ]]-uv-cache
    cmds:
{% if overrides.get("python:build") %}      - [[ overrides["python:build"] ]]
{% elif workspace %}      - |
        for package in {{.CLI_ARGS | default .PACKAGES}}; do
          uv build --package "$package" --out-dir dist
          uv export --format cyclonedx1.5 --frozen --no-default-groups --package "$package" -q -o "dist/$package.cdx.json"
        done
{% elif web %}      - uv build --package [[ api_package ]] --out-dir dist
      - uv export --format cyclonedx1.5 --frozen --no-default-groups --package [[ api_package ]] -q -o dist/[[ api_package ]].cdx.json
{% else %}      - uv build
      - uv export --format cyclonedx1.5 --frozen --no-default-groups -q -o dist/[[ name ]].cdx.json
{% endif %}
  version:
{% if workspace %}    desc: Print one package's version, or every package's when given no argument.
{% elif web %}    desc: Print the API package's version from pyproject.toml.
{% else %}    desc: Print the package version from pyproject.toml.
{% endif %}    internal: true
    silent: true
    cmds:
{% if overrides.get("python:version") %}      - [[ overrides["python:version"] ]]
{% elif workspace %}      - |
        if [ -n "{{.CLI_ARGS}}" ]; then
          uv version --short --package "{{.CLI_ARGS}}"
        else
          for package in {{.PACKAGES}}; do
            printf '%s %s\n' "$package" "$(uv version --short --package "$package")"
          done
        fi
{% elif web %}      - uv version --short --package [[ api_package ]]
{% else %}      - uv version --short
{% endif -%}