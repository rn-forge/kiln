#!/usr/bin/env node
// Generated by kiln [[ kiln_version ]] from .rn-forge/kiln/config.toml — do not edit; run 'kiln apply'
/**
 * Assembles the docs site into `dist/site/` from every project that declares
 * a `compodoc` or `build-storybook` target:
 *   dist/compodoc/<project>   -> dist/site/api/<project>/
 *   dist/storybook/<project>  -> dist/site/storybook/<project>/
 * plus a generated `index.html` and `.nojekyll`.
 *
 * Usage: node assemble-site.mjs   (run from the workspace root)
 */
import { execFileSync } from 'node:child_process';
import {
  cpSync,
  existsSync,
  mkdirSync,
  readFileSync,
  rmSync,
  writeFileSync,
} from 'node:fs';
import { basename, join } from 'node:path';

const root = process.cwd();
const site = join(root, 'dist', 'site');

const nx = (...args) =>
  JSON.parse(
    execFileSync('pnpm', ['exec', 'nx', ...args], {
      cwd: root,
      encoding: 'utf-8',
      stdio: ['ignore', 'pipe', 'inherit'],
    }),
  );

const escapeHtml = (s) =>
  String(s)
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;');

const description = (project) => {
  try {
    const { root: projectRoot } = nx('show', 'project', project, '--json');
    const pkg = JSON.parse(
      readFileSync(join(root, projectRoot, 'package.json'), 'utf-8'),
    );
    return pkg.description ?? '';
  } catch {
    return '';
  }
};

const sections = [
  { title: 'API reference', target: 'compodoc', src: 'compodoc', dir: 'api' },
  {
    title: 'Storybook',
    target: 'build-storybook',
    src: 'storybook',
    dir: 'storybook',
  },
];

rmSync(site, { recursive: true, force: true });
mkdirSync(site, { recursive: true });

let failed = false;
let body = '';
for (const { title, target, src, dir } of sections) {
  const projects = nx('show', 'projects', '--with-target', target, '--json');
  if (projects.length === 0) continue;
  let cards = '';
  for (const project of projects) {
    const from = join(root, 'dist', src, project);
    if (!existsSync(from)) {
      console.error(
        `${project}: expected ${target} output not found at ${from}`,
      );
      failed = true;
      continue;
    }
    cpSync(from, join(site, dir, project), { recursive: true });
    const desc = description(project);
    cards += `
        <a class="card" href="./${dir}/${encodeURIComponent(project)}/">
          <h3>${escapeHtml(project)}</h3>${desc ? `\n          <p>${escapeHtml(desc)}</p>` : ''}
        </a>`;
  }
  body += `
      <h2>${escapeHtml(title)}</h2>
      <div class="cards">${cards}
      </div>`;
}
if (failed) process.exit(1);

const name = escapeHtml(
  process.env.GITHUB_REPOSITORY?.split('/')[1] || basename(root),
);

writeFileSync(
  join(site, 'index.html'),
  `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>${name} docs</title>
    <style>
      :root {
        color-scheme: light dark;
        --fg: #1a1a1a;
        --bg: #ffffff;
        --muted: #666666;
        --border: #e0e0e0;
        --accent: #6236ff;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --fg: #f0f0f0;
          --bg: #121212;
          --muted: #a0a0a0;
          --border: #333333;
          --accent: #a78bfa;
        }
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        font-family:
          -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        color: var(--fg);
        background: var(--bg);
        display: flex;
        justify-content: center;
        padding: 4rem 1.5rem;
      }
      main {
        max-width: 720px;
        width: 100%;
      }
      h1 {
        font-size: 1.75rem;
        margin-bottom: 0.25rem;
      }
      h2 {
        font-size: 1.25rem;
        margin: 2rem 0 0;
      }
      .cards {
        display: grid;
        gap: 1rem;
        margin-top: 1rem;
      }
      a.card {
        display: block;
        padding: 1.25rem 1.5rem;
        border: 1px solid var(--border);
        border-radius: 10px;
        text-decoration: none;
        color: inherit;
      }
      a.card:hover {
        border-color: var(--accent);
      }
      a.card h3 {
        margin: 0 0 0.25rem;
        font-size: 1.1rem;
        color: var(--accent);
      }
      a.card p {
        margin: 0;
        color: var(--muted);
        font-size: 0.95rem;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>${name}</h1>${body}
    </main>
  </body>
</html>
`,
);
writeFileSync(join(site, '.nojekyll'), '');
