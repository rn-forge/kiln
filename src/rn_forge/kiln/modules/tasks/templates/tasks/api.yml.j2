# Generated by kiln [[ kiln_version ]] from .rn-forge/kiln/config.toml — do not edit; run 'kiln apply'
version: "3"

# The API service's own dev loop. Unlike the other namespace files, this one is
# public: `api:dev`{% if backend == "django" %} and `api:migrate` are{% else %} is{% endif %} how a developer runs it, not an internal
# step a wrapper calls. `[[ api_module ]].app:app` is the repo's
# own module — the standard says so, kiln does not render it.

tasks:
  dev:
    desc: Run the API dev server on port 8000.
    cmds:
{% if backend == "django" %}      - uv run --package [[ api_package ]] python [[ api_dir ]]/manage.py runserver 8000
{% else %}      - uv run --package [[ api_package ]] uvicorn [[ api_module ]].app:app --reload --port 8000
{% endif %}{% if backend == "django" %}  migrate:
    desc: Apply the API's Django migrations.
    cmds:
      - uv run --package [[ api_package ]] python [[ api_dir ]]/manage.py migrate
{% endif -%}
