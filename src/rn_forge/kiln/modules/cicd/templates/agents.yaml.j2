# Generated by kiln [[ kiln_version ]] from .rn-forge/kiln/config.toml — do not edit; run 'kiln apply'
launch-templates:
  linux-medium:
    resource-class: 'docker_linux_amd64/medium'
    image: '[[ nx_cloud_image ]]'
    init-steps:
      - name: Checkout
        uses: 'nrwl/nx-cloud-workflows/v6/workflow-steps/checkout/main.yaml'
      - name: Restore PNPM Store Cache
        uses: 'nrwl/nx-cloud-workflows/v6/workflow-steps/cache/main.yaml'
        inputs:
          # Invalidate cache when lockfile or patches change
          key: 'pnpm-lock.yaml|patches/**'
          # Target the standard PNPM global store directory path
          paths: |
            ~/.local/share/pnpm/store
          base-branch: 'main'
      - name: Setup PNPM
        script: |
          # `corepack enable` alone uses the pnpm version declared in package.json#packageManager
          corepack enable
          pnpm config set store-dir ~/.local/share/pnpm/store
      - name: Install Node Modules
        uses: 'nrwl/nx-cloud-workflows/v6/workflow-steps/install-node-modules/main.yaml'
      - name: Install Browsers
        uses: 'nrwl/nx-cloud-workflows/v6/workflow-steps/install-browsers/main.yaml'
      - name: Install uv
        script: |
          # A committed uv.lock turns this on; uv then downloads the Python version the project declares
          if [ -n "$(git ls-files '*uv.lock')" ]; then
            curl -LsSf https://astral.sh/uv/0.13.1/install.sh | UV_NO_MODIFY_PATH=1 sh
            echo "PATH=$HOME/.local/bin:$PATH" >> $NX_CLOUD_ENV
            "$HOME/.local/bin/uv" --version
          fi
