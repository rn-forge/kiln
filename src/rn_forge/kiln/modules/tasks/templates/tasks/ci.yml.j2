# Generated by kiln [[ kiln_version ]] from .rn-forge/kiln/config.toml — do not edit; run 'kiln apply'
version: "3"

# The CI module's check on the workflows it generates (zizmor and actionlint),
# internal, run by `lint`.
{% if workspace %}#
# What the CI workflow calls for a python-lib repo's per-package pipeline. These
# are public tasks, not `internal`: a workflow step runs them from the command
# line, which go-task refuses for an internal task. They are CI's, not a
# developer's; the ten root verbs do not change.
{% endif %}
vars:
  DEVOPS: '[[ devops ]]'

tasks:
  lint:workflows:
    desc: Fail on a workflow security finding (zizmor) or a workflow syntax error (actionlint).
    internal: true
    cmds:
{% if overrides.get("ci:lint:workflows") %}      - [[ overrides["ci:lint:workflows"] ]]
{% else %}      - uv run zizmor --offline .github
      - uv run actionlint
{% endif %}
  sonar-target:
    desc: "CI only: print the Sonar branch argument for this run as a $GITHUB_OUTPUT line"
    cmds:
      - '{{.DEVOPS}} sonar-target'
{% if workspace %}
  plan:
    desc: "CI only: print the plan's outputs for $GITHUB_OUTPUT"
    silent: true
    cmds:
      - |
        set -euo pipefail
        base="${BASE:-}"
        if [ "${EVENT_NAME:-}" = push ]; then
          base=$(gh run list --workflow ci.yml --branch main --event push --status success --limit 1 --json headSha --jq '.[0].headSha // ""')
        fi
        {{.DEVOPS}} plan "$base"

  adapters:
    desc: "CI only: check each package's declared adapters"
    silent: true
    cmds:
      - "{{.DEVOPS}} adapters"

  verify:
    desc: "CI only: lint, typecheck and test one member (-- <package>, with PACKAGE_DIR)"
    cmds:
      - uv run --directory "$PACKAGE_DIR" --package {{.CLI_ARGS}} ruff check src $(test -d "$PACKAGE_DIR/tests" && echo tests)
      - uv run --directory "$PACKAGE_DIR" --package {{.CLI_ARGS}} pyright src
      - uv run --directory "$PACKAGE_DIR" --package {{.CLI_ARGS}} pytest -q $PYTEST_ARGS

  postgres:
    desc: "CI only: a member's tests again against PostgreSQL (-- <package>, with PACKAGE_DIR)"
    cmds:
      - |
        export "$DSN_VAR=postgresql://ci:ci@localhost:5432/ci"
        uv run --directory "$PACKAGE_DIR" --package {{.CLI_ARGS}} pytest -q $PYTEST_ARGS

  smoke:
    desc: "CI only: install one extra from the built wheel and import it (-- <package> [extra])"
    silent: true
    cmds:
      - '{{.DEVOPS}} smoke {{.CLI_ARGS}} "${EXTRA:-}"'

  suite:
    desc: "CI only: run one workspace-wide pytest suite"
    cmds:
      - uv run pytest $SUITE_ARGS

  release-build:
    desc: "CI only: build the releasable packages and their SBOMs into dist/<package>/, prerequisites first"
    cmds:
      - |
        set -euo pipefail
        mapfile -t names < <(jq -r '.[]' <<<"$SELECTED")
        releasable="$({{.DEVOPS}} releasable ok "${names[@]}")"
        built=0
        for name in $releasable; do
          version="$(uv version --package "$name" --short)"
          tag="$name-v$version"
          draft=$(gh release view "$tag" --json isDraft --jq .isDraft 2>/dev/null || true)
          if [ "$draft" = false ]; then
            echo "Release $tag is already published, skipping."
            continue
          fi
          remote_tag=$(git ls-remote --tags origin "refs/tags/$tag")
          if [ -n "$remote_tag" ]; then
            git fetch --no-tags origin "refs/tags/$tag"
            worktree=$(mktemp -d)
            git worktree add --detach "$worktree" FETCH_HEAD
            uv build --directory "$worktree" --package "$name" --out-dir "$GITHUB_WORKSPACE/dist/$name"
            uv export --format cyclonedx1.5 --frozen --no-default-groups --directory "$worktree" --package "$name" -q -o "$GITHUB_WORKSPACE/dist/$name/$name.cdx.json"
            git worktree remove "$worktree"
          else
            uv build --package "$name" --out-dir "dist/$name"
            uv export --format cyclonedx1.5 --frozen --no-default-groups --package "$name" -q -o "dist/$name/$name.cdx.json"
          fi
          built=$((built + 1))
        done
        printf 'built=%s\n' "$built" >> "$GITHUB_OUTPUT"

  release-publish:
    desc: "CI only: publish a GitHub release for each package release-build built, prerequisites first"
    cmds:
      - |
        set -euo pipefail
        mapfile -t names < <(jq -r '.[]' <<<"$SELECTED")
        releasable="$({{.DEVOPS}} releasable ok "${names[@]}")"
        for name in $releasable; do
          version="$(uv version --package "$name" --short)"
          tag="$name-v$version"
          draft=$(gh release view "$tag" --json isDraft --jq .isDraft 2>/dev/null || true)
          if [ "$draft" = false ] || [ ! -d "dist/$name" ]; then
            echo "Nothing to publish for $tag, skipping."
            continue
          fi
          remote_tag=$(git ls-remote --tags origin "refs/tags/$tag")
          if [ "$draft" = true ]; then
            gh release delete "$tag" --yes
          fi
          if [ -n "$remote_tag" ]; then
            gh release create "$tag" dist/"$name"/* --verify-tag --title "$name v$version" --generate-notes
          else
            gh release create "$tag" dist/"$name"/* --target "$GITHUB_SHA" --title "$name v$version" --generate-notes
          fi
        done

  external-install:
    desc: "CI only: install each released tag from git, outside the workspace"
    cmds:
      - |
        set -euo pipefail
        tmp=$(mktemp -d)
        {{.DEVOPS}} released | while read -r name dir module version; do
          tag="$name-v$version"
          git fetch --no-tags origin "refs/tags/$tag"
          uv venv -q "$tmp/$name"
          VIRTUAL_ENV="$tmp/$name" uv pip install -q \
            "$name @ git+$REPOSITORY_URL@$tag#subdirectory=$dir"
          "$tmp/$name/bin/python" -c "import $module"
        done
{% if docs %}
  docs-publish:
    desc: "CI only: deploy each released package's versioned site, then build the root site (SITE_DIR) with packages/ merged in"
    cmds:
      - |
        set -euo pipefail
        git config user.name "github-actions[bot]"
        git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
        {{.DEVOPS}} released | while read -r _ dir _ version; do
          config="$dir/mkdocs.yml"
          [ -f "$config" ] || continue
          first=$(uv run --group docs mike list --deploy-prefix "$dir" -F "$config" 2>/dev/null | wc -l || true)
          uv run --group docs mike deploy --deploy-prefix "$dir" -F "$config" \
            --alias-type copy --update-aliases --push "${version%.*}" latest
          if [ "$first" -eq 0 ]; then
            uv run --group docs mike set-default --deploy-prefix "$dir" -F "$config" --push latest
          fi
        done
      - '{{.TASK_EXE}} docs:build -- "$SITE_DIR"'
      - |
        if git fetch origin gh-pages; then
          git archive FETCH_HEAD packages | tar -x -C "$SITE_DIR"
        fi
{% endif %}
{% endif %}