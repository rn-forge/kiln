# Generated by kiln [[ kiln_version ]] from .rn-forge/kiln/config.toml — do not edit; run 'kiln apply'
name: Release

on:
  workflow_dispatch:
    inputs:
      specifier:
        description: 'Version bump'
        required: true
        type: choice
        options: [patch, minor, major]
        default: patch
      exact-version:
        description: 'Exact version (overrides bump; leave empty normally)'
        required: false
        type: string
      dist-tag:
        description: 'npm dist-tag (latest for current releases; v<major>-lts for hotfixes to older majors)'
        required: true
        type: string
        default: 'latest'
      dry-run:
        description: 'Dry run (no commit/tag/publish)'
        required: true
        type: boolean
        default: true
      first-release:
        description: 'First release ever (no existing git tags)'
        required: false
        type: boolean
        default: false

permissions:
  contents: read

concurrency:
  group: release
  cancel-in-progress: false # never cancel a running release

jobs:
  release:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      contents: write # push release commit + tags, create GitHub Releases
      id-token: write # npm OIDC trusted publishing
      actions: read # read ci.yml runs for the gate
    outputs:
      tag: ${{ steps.tag.outputs.name }}
    steps:
      # The release commit is pushed to a protected branch, so git runs as the release
      # GitHub App (a bypass actor on the branch ruleset); GITHUB_TOKEN cannot bypass it.
      - uses: [[ pins["create-github-app-token"].uses ]]@[[ pins["create-github-app-token"].sha ]] # [[ pins["create-github-app-token"].version ]]
        id: app-token
        with:
          client-id: ${{ vars.RELEASE_APP_CLIENT_ID }}
          private-key: ${{ secrets.RELEASE_APP_PRIVATE_KEY }}
          permission-contents: write

      - uses: [[ pins["checkout"].uses ]]@[[ pins["checkout"].sha ]] # [[ pins["checkout"].version ]]
        with:
          token: ${{ steps.app-token.outputs.token }}
          fetch-depth: 0 # full history required for git-tag version resolution
          filter: tree:0
          persist-credentials: true # the release commit and tag are pushed with this token

      # npm >= 11.5.1 is required for OIDC publishing (Node version from .nvmrc)
      - uses: ./.github/actions/setup # zizmor: ignore[self-repository] actionlint rejects the $/ form
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}
          registry-url: 'https://registry.npmjs.org'

      # A release commit's own ci.yml run may not have finished (or may be absent),
      # so a resumed release gates on the commit it was cut from (HEAD^).
      - name: Gate on a green CI run
        run: task ci:release:gate
        env:
          GH_TOKEN: ${{ github.token }}
          DRY_RUN: ${{ inputs.dry-run }}

      # The checkout fetched tags from origin, so a tag at HEAD is a pushed tag.
      # A version counts as shipped only when its GitHub Release is published.
      - name: Detect release state
        id: state
        run: task ci:release:state
        env:
          GH_TOKEN: ${{ github.token }}

      - name: Configure git author
        run: task ci:release:author

      # Commits and tags locally only; nothing is pushed until the checks pass.
      # Publishing is excluded (--skip-publish) because the combined command
      # cannot pass a custom npm dist-tag; the Publish step below does that.
      - name: Version locally
        if: ${{ !inputs.dry-run && steps.state.outputs.mode == 'new' }}
        run: task ci:release:version
        env:
          VERSION_SPEC: ${{ inputs.exact-version != '' && inputs.exact-version || inputs.specifier }}
          FIRST_RELEASE: ${{ inputs.first-release }}
          DRY_RUN: ${{ inputs.dry-run }}

      # In resume and released modes HEAD already carries the tag, so this resolves it too.
      - name: Resolve release tag
        if: ${{ !inputs.dry-run }}
        id: tag
        run: task ci:release:tag

      # Dry runs deliberately do NOT use the combined `nx release` command
      # as it does not write files when dry-run flag is present.
      # so dist manifests still carry workspace:* references that pnpm publish rejects
      - name: Version (dry-run simulation)
        if: ${{ inputs.dry-run }}
        run: task ci:release:version
        env:
          VERSION_SPEC: ${{ inputs.exact-version != '' && inputs.exact-version || inputs.specifier }}
          FIRST_RELEASE: ${{ inputs.first-release }}
          DRY_RUN: ${{ inputs.dry-run }}

      # Both version paths rewrite workspace:* peer deps to exact pins in the dist
      # manifest roots. --excludeTaskDependencies packs the versioned dist/ rather
      # than rebuilding it.
      - name: Verify
        if: ${{ inputs.dry-run || steps.state.outputs.mode == 'new' }}
        run: task ci:release:verify

      # Resume: preVersionCommand does not run, so dist/ is rebuilt from the tagged
      # source (with task dependencies) and pack stamps the exact internal pins.
      - name: Rebuild and verify (resume)
        if: ${{ !inputs.dry-run && steps.state.outputs.mode == 'resume' }}
        run: task ci:release:verify
        env:
          MODE: resume

      - name: Push release commit and tag
        if: ${{ !inputs.dry-run && steps.state.outputs.mode == 'new' }}
        run: task ci:release:push
        env:
          TAG: ${{ steps.tag.outputs.name }}

      - name: Create GitHub Release
        if: ${{ !inputs.dry-run && steps.state.outputs.mode != 'released' }}
        run: task ci:release:github
        env:
          TAG: ${{ steps.tag.outputs.name }}
          GH_TOKEN: ${{ github.token }}

      # --excludeTaskDependencies to not invalidate cache and use already prepped version in dist/
      # step's preVersionCommand.
      - name: Publish
        if: ${{ inputs.dry-run || steps.state.outputs.mode != 'released' }}
        run: task ci:release:publish
        env:
          DIST_TAG: ${{ inputs.dist-tag }}
          DRY_RUN_FLAG: ${{ inputs.dry-run && '--dry-run' || '' }}
          FIRST_RELEASE_FLAG: ${{ inputs.first-release && '--first-release' || '' }}

      # Rolling pointer so consumers can depend on a stable, version-less URL
      # (.../releases/download/latest/<pkg>.tgz) instead of tracking exact tags.
      - name: Update rolling "latest" release
        if: ${{ !inputs.dry-run && github.ref_name == 'main' }}
        run: task ci:release:latest
        env:
          GH_TOKEN: ${{ github.token }}
          TAG: ${{ steps.tag.outputs.name }}

      - name: Already released
        if: ${{ !inputs.dry-run && steps.state.outputs.mode == 'released' }}
        run: echo "::notice::$TAG is already released"
        env:
          TAG: ${{ steps.tag.outputs.name }}

  # Installs what consumers download, not what the release runner built.
  published-install:
    needs: release
    if: ${{ !inputs.dry-run }}
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: read
    steps:
      - uses: [[ pins["checkout"].uses ]]@[[ pins["checkout"].sha ]] # [[ pins["checkout"].version ]]
        with:
          ref: ${{ needs.release.outputs.tag }}
          persist-credentials: false

      - uses: ./.github/actions/setup # zizmor: ignore[self-repository] actionlint rejects the $/ form
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}

      - name: Verify the released tarballs
        run: task ci:published-install
        env:
          TAG: ${{ needs.release.outputs.tag }}
          GH_TOKEN: ${{ github.token }}
