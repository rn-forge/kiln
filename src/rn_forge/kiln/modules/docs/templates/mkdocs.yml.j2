# Generated by kiln {{ kiln_version }} from .rn-forge/kiln/config.toml — do not edit; run 'kiln apply'
site_name: {{ name }}
{{ site_description_line }}
{% if site_dir %}site_dir: {{ site_dir }}
{% endif %}docs_dir: docs
exclude_docs: "_*"
strict: true
theme:
  name: material
  # Each area is a tab with its own sidebar (kiln ADR-0013); an area's
  # index.md is the tab's page, so no area's pages stack on another's.
  features:
    - navigation.tabs
    - navigation.tabs.sticky
    - navigation.indexes
    - navigation.top
    - content.code.copy
    - search.suggest
    - search.highlight
  palette:
    - media: "(prefers-color-scheme: light)"
      scheme: default
      toggle:
        icon: material/brightness-7
        name: Switch to dark mode
    - media: "(prefers-color-scheme: dark)"
      scheme: slate
      toggle:
        icon: material/brightness-4
        name: Switch to light mode
{{ theme_extra }}plugins:
  - search
{% if archetype == "python-lib" %}  - monorepo
{% endif %}  - mkdocstrings:
      handlers:
        python:
          paths: [{{ source_paths }}]
          options:
            docstring_style: google
            show_source: true
            show_root_heading: true
{{ plugins_extra }}markdown_extensions:
  - admonition
  - attr_list
  - pymdownx.highlight:
      anchor_linenums: true
{% if archetype == "python-lib" %}  - pymdownx.snippets:
      check_paths: true
{% endif %}  - pymdownx.superfences
{{ markdown_extensions_extra }}{{ top_level_extra }}# The nav below is derived by `kiln docs-generate` from docs/_areas.yml and
# the tree — do not hand-edit between the markers; run `task docs:generate`
# after adding a page. `task lint` fails on a stale nav.
nav:
  # BEGIN derived nav
  # END derived nav
