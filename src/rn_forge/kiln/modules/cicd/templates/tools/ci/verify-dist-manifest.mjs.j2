#!/usr/bin/env node
// Generated by kiln [[ kiln_version ]] from .rn-forge/kiln/config.toml — do not edit; run 'kiln apply'
/**
 * Verifies the built package manifest at `<dist-dir>/package.json`:
 * no `workspace:` protocol ranges, required fields present, and entry points
 * and type declarations referenced.
 *
 * Usage: node verify-dist-manifest.mjs <dist-dir>
 */
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

const [, , distDirArg] = process.argv;
if (!distDirArg) {
  console.error('Usage: node verify-dist-manifest.mjs <dist-dir>');
  process.exit(1);
}

const manifestPath = join(process.cwd(), distDirArg, 'package.json');

/** @type {string[]} */
const errors = [];

let manifest;
try {
  manifest = JSON.parse(readFileSync(manifestPath, 'utf-8'));
} catch (err) {
  console.error(`Could not read/parse ${manifestPath} (${err.message})`);
  process.exit(1);
}

for (const field of [
  'dependencies',
  'peerDependencies',
  'optionalDependencies',
]) {
  const deps = manifest[field];
  if (!deps) continue;
  for (const [dep, range] of Object.entries(deps)) {
    if (typeof range === 'string' && range.startsWith('workspace:')) {
      errors.push(
        `${field}["${dep}"] uses "workspace:" protocol (${range}) in dist manifest`,
      );
    }
  }
}

for (const field of ['name', 'version']) {
  if (!manifest[field]) {
    errors.push(`missing required field "${field}"`);
  }
}
if (!manifest.module && !manifest.exports) {
  errors.push(
    'missing both "module" and "exports" (no entry point referenced)',
  );
}
if (!manifest.typings && !manifest.exports) {
  errors.push(
    'missing both "typings" and "exports" (no type declarations referenced)',
  );
}

if (errors.length > 0) {
  console.error(`Dist manifest verification failed for ${distDirArg}:\n`);
  for (const err of errors) {
    console.error(`  - ${err}`);
  }
  process.exit(1);
}

console.log(`Dist manifest verification passed for ${distDirArg}`);
