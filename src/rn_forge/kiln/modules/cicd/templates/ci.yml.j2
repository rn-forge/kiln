{#- One list of what runs before anything publishes, and one body for both gate jobs.
    A later stage adds its job here and nowhere else. #}
{%- macro prerelease_needs() -%}
validate, dependency-review
{%- if node_lib %}, test-cloud, test-local, smoke{% endif -%}
{%- if not node_lib %}, plan, test, integration, smoke, suites{% endif -%}
{%- if sonar %}, sonar{% endif -%}
{%- for job in check_jobs %}, [[ job ]]{% endfor -%}
{%- for job in required_jobs %}, [[ job ]]{% endfor -%}
{%- endmacro %}
{%- macro postrelease_needs() -%}
{%- if release != "none" %}, release, verify-release{% endif -%}
{%- if "umbrella-release" in checks %}, umbrella{% endif -%}
{%- if docs %}, docs{% endif -%}
{%- endmacro %}
{#- `docs` waits for the barrier and for each release stage that is rendered; a skipped
    release stage (nothing to publish) still lets the site deploy. #}
{%- macro docs_needs(plan) -%}
checks-ok{% if plan %}, plan{% endif %}{% if release != "none" %}, release, verify-release{% endif %}
{%- endmacro %}
{%- macro docs_if(plan) -%}
${{ !cancelled() && needs.checks-ok.result == 'success' && !contains(needs.*.result, 'failure') && !contains(needs.*.result, 'cancelled') {% if plan %}&& needs.plan.outputs.docs == 'true' {% endif %}&& github.event_name == 'push' && github.ref_name == 'main' }}
{%- endmacro %}
{#- The one `if` of the `sonar` job in every archetype: it scans a same-repository pull
    request and main, never Dependabot's (no Actions secrets there). #}
{%- macro sonar_guard() -%}
${{ !cancelled() && !contains(needs.*.result, 'failure') && github.actor != 'dependabot[bot]' && ((github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name == github.repository) || (github.event_name != 'pull_request' && github.ref == 'refs/heads/main')) }}
{%- endmacro %}
{%- macro gate_job(name, needs) %}
  [[ name ]]:
    needs: [[ "[" ~ needs ~ "]" ]]
    if: always()
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions: {}
    steps:
      - name: Every job passed or was skipped
        if: contains(needs.*.result, 'failure') || contains(needs.*.result, 'cancelled')
        run: exit 1
{%- endmacro %}

{% if not node_lib %}# validate → plan → test, integration, smoke, suites → sonar → release{% if release != "none" %} → verify-release{% endif %}{% if docs %}{% if release == "none" %} →{% else %},{% endif %} docs{% endif %}.
#
# validate: the repository-wide checks ({% if workspace %}lint, adapters, docs build{% else %}lint, typecheck{% if docs %}, docs build{% endif %}{% endif %}), once.
# plan:     reads the uv workspace{% if not workspace %} (here a workspace of one member, the root project){% endif %} and selects the changed packages and their
#           dependents, as the outputs every later job reads.
# test:     one job per selected package — {% if workspace %}lint, typecheck and test that member{% else %}`task test`{% endif %}.
# integration, smoke, suites: the jobs a package or the workspace declares —
#           tests against the service containers a package declares, one extra
#           installed alone, workspace-wide pytest.
# sonar:    the scan, once test, integration and smoke have passed.
{% if workspace %}# release:  the selected packages whose checks all passed, in dependency order,
#           each on its own `<package>-v<version>` tag.
{% elif release != "none" %}# release:  publishes the version once everything before it has passed.
{% endif %}{% if release != "none" %}# verify-release: installs what was published, from {% if release == "pypi" %}PyPI{% else %}its git tag{% endif %}, outside the repository, and imports it.
{% endif %}{% if docs %}# docs:     deploys {% if workspace %}each released package's versioned site and the root site{% else %}the site{% endif %} to Pages once the barrier{% if release != "none" %} and the release stages{% endif %} have passed.
{% endif %}{% else %}# validate → test-cloud or test-local → sonar, smoke, docs → ci-ok.
#
# test-cloud:  `nx affected` distributed over Nx Cloud agents (.nx/workflows/agents.yaml).
# test-local:  the same on the runner, unless `USE_NX_CLOUD` is `true` or dispatch checks it.
{% endif %}#
# Every step goes through `task`; `kiln doctor`'s ci-entrypoint rule fails the
# build if a step invokes {% if node_lib %}uv/mkdocs/pnpm/npx/nx/ng/kiln{% else %}uv/pytest/ruff/pyright/mkdocs/kiln{% endif %} directly. kiln runs
# here only as the version `[kiln] ref` pins, read-only, through
