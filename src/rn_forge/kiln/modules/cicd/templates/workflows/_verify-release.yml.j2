name: Verify release

on:
  workflow_call:
{% if not workspace %}    inputs:
      tag:
        description: The tag the release published
        type: string
        required: true
{% endif %}
permissions:
  contents: read

jobs:{% if node_lib %}
  # Installs what consumers download, not what the release runner built.
  verify-release:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: read
    steps:
      - uses: [[ pins["checkout"].uses ]]@[[ pins["checkout"].sha ]] # [[ pins["checkout"].version ]]
        with:
          ref: ${{ inputs.tag }}
          persist-credentials: false

      - uses: ./.github/actions/setup # zizmor: ignore[self-repository] actionlint rejects the $/ form
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}

      - name: Verify the released tarballs
        run: task ci:verify-release
        env:
          TAG: ${{ inputs.tag }}
          GH_TOKEN: ${{ github.token }}{% elif workspace %}
  # Package checks resolve internal dependencies from the workspace, which
  # never proves a tag installs on its own.
  verify-release:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: read
    steps:
      - name: Checkout
        uses: [[ pins["checkout"].uses ]]@[[ pins["checkout"].sha ]] # [[ pins["checkout"].version ]]
        with:
          fetch-depth: 0
          persist-credentials: false

      - name: Set up the toolchain
        uses: ./.github/actions/setup # zizmor: ignore[self-repository] actionlint rejects the $/ form
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}

      - name: Verify remote tags and clean installs
        env:
          REPOSITORY_URL: ${{ github.server_url }}/${{ github.repository }}
        run: task ci:verify-release{% else %}
  verify-release:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: read
    steps:
      - name: Checkout
        uses: [[ pins["checkout"].uses ]]@[[ pins["checkout"].sha ]] # [[ pins["checkout"].version ]]
        with:
          fetch-depth: 0
          persist-credentials: false

      - name: Set up the toolchain
        uses: ./.github/actions/setup # zizmor: ignore[self-repository] actionlint rejects the $/ form
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}

      - name: Verify the remote tag and a clean install
        env:
          REPOSITORY_URL: ${{ github.server_url }}/${{ github.repository }}
          TAG: ${{ inputs.tag }}
        run: task ci:verify-release -- "$TAG"{% endif %}
