; Generated by kiln golden from .rn-forge/kiln/config.toml — do not edit; run 'kiln apply'
;
; The import boundary, executable (kiln ADR-0002). rn-forge-commons and
; rn-forge-tooling are the only rn-forge packages kiln may import: agentkit is
; a subprocess and nothing else, and a framework's generators are reached
; through the `rn_forge.kiln.generators` entry-point group, never imported.
; That is what keeps the library graph acyclic while leaving the tooling graph
; free (D1).
;
; The rn-forge half of that rule is not here and cannot be: import-linter
; rejects subpackages of external packages, so `rn_forge.agentkit` is not a
; legal forbidden module. It is enforced at the dependency declaration instead,
; by scripts/standards/check_rn_forge_deps.py (kiln ADR-0005).
;
; kiln has no source to constrain yet — Phase B ships the canon and the golden
; repos, not the generator. The contract is written now so it is in place
; before the first import is.

[importlinter]
root_package = rn_forge.kiln
include_external_packages = True

[importlinter:contract:no-kit-imports]
name = kiln imports no framework or CLI toolkit directly
type = forbidden
source_modules =
    rn_forge.kiln
forbidden_modules =
    typer
    jinja2
    click
    django
    fastapi
allow_indirect_imports = False
