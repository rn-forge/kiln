# Generated by kiln [[ kiln_version ]] from .rn-forge/kiln/config.toml — do not edit; run 'kiln apply'
name: Release

on:
  workflow_call:
{% if node_lib %}    outputs:
      tag:
        description: The tag this run published; empty when the version was already released
        value: ${{ jobs.release.outputs.tag }}
    secrets:
      RELEASE_APP_PRIVATE_KEY:
        description: The release GitHub App's private key
        required: true
{% else %}    outputs:
      tag:
        description: The tag this run published; empty when the version was already released
        value: ${{ jobs.release.outputs.tag }}
{% endif %}
permissions:
  contents: read

jobs:{% if node_lib %}
  # The version is bumped in a pull request (`task version -- <bump>`); this job
  # tags it, publishes it, and never commits. Only a push to the default branch,
  # after `checks-ok`, gets here.
  release:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    concurrency:
      group: release
      cancel-in-progress: false # never cancel a running release
    permissions:
      contents: write # create GitHub Releases
      id-token: write # npm OIDC trusted publishing
    # The tag this run published; empty when the version was already released.
    outputs:
      tag: ${{ steps.state.outputs.mode != 'released' && steps.state.outputs.tag || '' }}
    steps:
      # The tag is pushed to a protected ref, so git runs as the release GitHub
      # App (a bypass actor on the tag ruleset); GITHUB_TOKEN cannot bypass it.
      - uses: [[ pins["create-github-app-token"].uses ]]@[[ pins["create-github-app-token"].sha ]] # [[ pins["create-github-app-token"].version ]]
        id: app-token
        with:
          client-id: ${{ vars.RELEASE_APP_CLIENT_ID }}
          private-key: ${{ secrets.RELEASE_APP_PRIVATE_KEY }}
          permission-contents: write

      - uses: [[ pins["checkout"].uses ]]@[[ pins["checkout"].sha ]] # [[ pins["checkout"].version ]]
        with:
          token: ${{ steps.app-token.outputs.token }}
          fetch-depth: 0 # every v* tag, to tell a first release
          filter: tree:0
          persist-credentials: true # the tag is pushed with this token

      # npm >= 11.5.1 is required for OIDC publishing (Node version from .nvmrc)
      - uses: ./.github/actions/setup # zizmor: ignore[self-repository] actionlint rejects the $/ form
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}
          registry-url: 'https://registry.npmjs.org'

      # A version counts as shipped only when its GitHub Release is published.
      - name: Detect release state
        id: state
        run: task ci:release:state
        env:
          GH_TOKEN: ${{ github.token }}

      - name: Configure git author
        if: ${{ steps.state.outputs.mode != 'released' }}
        run: task ci:release:author

      - name: Tag the release
        if: ${{ steps.state.outputs.mode == 'new' }}
        run: task ci:release:tag
        env:
          TAG: ${{ steps.state.outputs.tag }}

      # dist/ is rebuilt from the tagged source, with task dependencies, and pack
      # stamps the exact internal pins.
      - name: Rebuild and verify
        if: ${{ steps.state.outputs.mode != 'released' }}
        run: task ci:release:verify

      - name: Push the tag
        if: ${{ steps.state.outputs.mode == 'new' }}
        run: task ci:release:push
        env:
          TAG: ${{ steps.state.outputs.tag }}

      # A draft until npm has the version, so a published release is a finished one.
      - name: Create the draft GitHub Release
        if: ${{ steps.state.outputs.mode != 'released' }}
        run: task ci:release:github
        env:
          TAG: ${{ steps.state.outputs.tag }}
          GH_TOKEN: ${{ github.token }}

      # --excludeTaskDependencies to not invalidate cache and use the dist/ the
      # verify step built. nx skips a version npm already has.
      - name: Publish
        if: ${{ steps.state.outputs.mode != 'released' }}
        run: task ci:release:publish
        env:
          DIST_TAG: ${{ steps.state.outputs.dist-tag }}
          FIRST_RELEASE_FLAG: ${{ steps.state.outputs.first-release == 'true' && '--first-release' || '' }}

      - name: Publish the GitHub Release
        if: ${{ steps.state.outputs.mode != 'released' }}
        run: task ci:release:finalize
        env:
          TAG: ${{ steps.state.outputs.tag }}
          GH_TOKEN: ${{ github.token }}

      # Rolling pointer so consumers can depend on a stable, version-less URL
      # (.../releases/download/latest/<pkg>.tgz) instead of tracking exact tags.
      - name: Update rolling "latest" release
        if: ${{ steps.state.outputs.mode != 'released' }}
        run: task ci:release:latest
        env:
          GH_TOKEN: ${{ github.token }}
          TAG: ${{ steps.state.outputs.tag }}

      - name: Already released
        if: ${{ steps.state.outputs.mode == 'released' }}
        run: echo "::notice::$TAG is already released"
        env:
          TAG: ${{ steps.state.outputs.tag }}{% else %}
  release:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    # The tag this run published; empty when the version was already released.
    outputs:
      tag: ${{ steps.check.outputs.should-release == 'true' && steps.check.outputs.tag || '' }}
    permissions:
      contents: write
      id-token: write
      attestations: write
    steps:
      - name: Checkout
        uses: [[ pins["checkout"].uses ]]@[[ pins["checkout"].sha ]] # [[ pins["checkout"].version ]]
        with:
          persist-credentials: false

      - name: Set up the toolchain
        uses: ./.github/actions/setup # zizmor: ignore[self-repository] actionlint rejects the $/ form
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}

      # The release, not the tag, is the record of what shipped.
      - name: Check whether this version has been released
        id: check
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: task ci:release:state >> "$GITHUB_OUTPUT"

      # A tag without a published release is a failed release: rebuild from it.
      - name: Check out the release source
        id: source
        if: steps.check.outputs.should-release == 'true'
        env:
          TAG: ${{ steps.check.outputs.tag }}
        run: task ci:release:source >> "$GITHUB_OUTPUT"

      - name: Build
        if: steps.check.outputs.should-release == 'true'
        run: task build

      # Attested before the release is published, because the release, not the
      # tag, is the record: a failure here leaves nothing published.
      - name: Generate provenance
        if: steps.check.outputs.should-release == 'true'
        uses: [[ pins["attest"].uses ]]@[[ pins["attest"].sha ]] # [[ pins["attest"].version ]]
        with:
          subject-path: |
            dist/*.whl
            dist/*.tar.gz
            dist/*.cdx.json

      # Publishing makes the tag at the source commit; a resumed release reuses its tag.
      - name: Publish GitHub Release
        if: steps.check.outputs.should-release == 'true'
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          TAG: ${{ steps.check.outputs.tag }}
          SOURCE_SHA: ${{ steps.source.outputs.sha }}
        run: task ci:release:publish{% endif %}
