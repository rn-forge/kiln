# Generated by kiln [[ kiln_version ]] from .rn-forge/kiln/config.toml — do not edit; run 'kiln apply'
version: "3"

# The CI module's check on the workflows it generates (zizmor and actionlint),
# internal, run by `lint`.
{% if not node_lib %}#
# What the CI workflow calls for a [[ "python-lib" if workspace else "single-package Python" ]] repo's per-package pipeline. These
# are public tasks, not `internal`: a workflow step runs them from the command
# line, which go-task refuses for an internal task. They are CI's, not a
# developer's; the ten root verbs do not change.
{% endif %}
vars:
  DEVOPS: '[[ devops ]]'

tasks:
  lint:workflows:
    desc: Fail on a workflow security finding (zizmor) or a workflow syntax error (actionlint).
    internal: true
    cmds:
{% if overrides.get("ci:lint:workflows") %}      - [[ overrides["ci:lint:workflows"] ]]
{% else %}      - uv run zizmor --offline .github
      - uv run actionlint
{% endif %}
{% if secret_scan_enabled %}  secret-scan:
    desc: "CI only: Scan the git history for secrets with the pinned gitleaks (downloads it on first run, so it is not part of lint)."
    cmds:
      - task: secrets:install
      - .rn-forge/kiln/rendered/bin/gitleaks detect --source . --redact --no-banner --exit-code 1

  secrets:install:
    desc: Download the pinned gitleaks release, check its sha256, and unpack the binary.
    internal: true
    status:
      - test -x .rn-forge/kiln/rendered/bin/gitleaks
    cmds:
      - |
        set -euo pipefail
        platform="$(uname -s)-$(uname -m)"
        case "$platform" in
{% for item in gitleaks %}          [[ item.uname ]])
            url='[[ item.url ]]'
            sha256='[[ item.sha256 ]]'
            ;;
{% endfor %}          *)
            echo "unsupported platform: $platform" >&2
            exit 1
            ;;
        esac
        tmp="$(mktemp -d)"
        curl -fsSL "$url" -o "$tmp/gitleaks.tar.gz"
        echo "$sha256  $tmp/gitleaks.tar.gz" | shasum -a 256 -c -
        mkdir -p .rn-forge/kiln/rendered/bin
        tar -xzf "$tmp/gitleaks.tar.gz" -C .rn-forge/kiln/rendered/bin gitleaks
        rm -rf "$tmp"
{% endif %}
  sonar:target:
    desc: "CI only: Print the Sonar branch argument for this run as a $GITHUB_OUTPUT line."
    cmds:
      - '{{.DEVOPS}} sonar-target'
{% if umbrella_release_enabled %}
  release:umbrella:
    desc: "CI only: Create a GitHub release for each shipped release page that has none."
    cmds:
      - '{{.DEVOPS}} umbrella --sha "$GITHUB_SHA"'
{% endif %}{% if not workspace and not node_lib %}
  release:state:
    desc: "CI only: Print the release's state for this version as $GITHUB_OUTPUT lines."
    cmds:
      - '{{.DEVOPS}} release-state "v$({{.TASK_EXE}} version)"'

  release:source:
    desc: "CI only: Check out the tagged source of a resumed release (with TAG), print its commit."
    cmds:
      - '{{.DEVOPS}} release-source "$TAG"'

  release:publish:
    desc: "CI only: Publish the GitHub release for TAG, from the built distributions, at SOURCE_SHA."
    cmds:
      - '{{.DEVOPS}} release-publish "$TAG" --title "$TAG" --target "$SOURCE_SHA" dist/*.whl dist/*.tar.gz dist/*.cdx.json'
{% endif %}{% if node_lib %}
  internal-ranges:
    desc: "CI only: Check that members depend on each other by workspace:^ or workspace:~."
    silent: true
    cmds:
      - "set -o pipefail; pnpm ls -r --depth -1 --json | {{.DEVOPS}} requirements --stack node"

  validate:
    desc: "CI only: Run the checks that do not run Nx — Markdown and TOML formatting, kiln's checks, workflow security{% if docs %}, the docs build{% endif %}; test-cloud or test-local run the Nx projects."
    cmds:
      - task: :quality:lint:markdown
      - task: :quality:lint:toml
      - task: :kiln:doctor
      - task: lint:workflows
      - task: internal-ranges
{% for verb in ["lint", "typecheck", "test"] %}{% for ref in extra_refs.get(verb, []) %}      - task: :[[ ref ]]
{% endfor %}{% endfor %}{% if docs %}      - task: :docs:build
{% endif %}{% for ref in extra_refs.get("validate", []) %}      - task: :[[ ref ]]
{% endfor %}
  test:
    desc: "CI only: Run Nx targets (-- <targets>) on the affected projects, or on all of them for a dispatch or a change outside every project."
    cmds:
      - |
        set -euo pipefail
        outside_projects() {
          base="$1" head="$2"
          shift 2
          git diff --name-only "$base" "$head" | while IFS= read -r file; do
            case "$file" in docs/* | *.md) continue ;; esac
            inside=false
            for root in "$@"; do
              if [ "$root" = . ]; then inside=true; break; fi
              case "$file" in "$root"/*) inside=true; break ;; esac
            done
            if [ "$inside" = false ]; then echo "$file"; fi
          done
        }
        all=false
        if [ "${GITHUB_EVENT_NAME:-}" = workflow_dispatch ]; then
          all=true
        else
          roots=()
          for project in $(pnpm exec nx show projects --json | jq -r '.[]'); do
            roots+=("$(pnpm exec nx show project "$project" --json | jq -r '.root')")
          done
          if [ -n "$(outside_projects "$NX_BASE" "$NX_HEAD" "${roots[@]}")" ]; then
            all=true
          fi
        fi
        if [ "$all" = true ]; then
          pnpm exec nx run-many -t {{.CLI_ARGS}}
        else
          pnpm exec nx affected -t {{.CLI_ARGS}}
        fi

  test:has-e2e:
    desc: "CI only: Print whether any project has an e2e target, as a $GITHUB_OUTPUT line."
    cmds:
      - echo "has-e2e=$(pnpm exec nx show projects --with-target e2e --json | jq 'length > 0')"

  test:playwright:
    desc: "CI only: Install Playwright's browsers and their system dependencies."
    cmds:
      - pnpm exec playwright install --with-deps

  test:playwright-deps:
    desc: "CI only: Install Playwright's system dependencies, the browsers being cached."
    cmds:
      - pnpm exec playwright install-deps

  sonar:reports:
    desc: "CI only: Print the lcov reports found under coverage/ as a reports=<list> $GITHUB_OUTPUT line, failing when a project wrote none."
    cmds:
      - |
        set -eu
        reports=$(find coverage -name lcov.info 2>/dev/null | sort | paste -sd, -)
        if [ -z "$reports" ] && [ "$(pnpm exec nx show projects --json)" != "[]" ]; then
          echo "::error::No lcov.info found under coverage/"
          exit 1
        fi
        echo "reports=$reports"

  smoke:
    desc: "CI only: Pack the publishable projects and verify their tarballs."
    cmds:
      - pnpm exec nx run-many -t pack verify-dist verify-consumer
{% if release == "nx-dispatch" %}
  release:state:
    desc: "CI only: Write tag, mode=new|resume|released, first-release and dist-tag for the version in the pull request to $GITHUB_OUTPUT."
    cmds:
      - |
        v=$({{.TASK_EXE}} --silent version)
        tag="v$v"
        if ! git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then
          mode=new
        elif [ "$(gh release view "$tag" --json isDraft --jq .isDraft 2>/dev/null)" = false ]; then
          mode=released
        elif [ "$(git rev-parse "$tag^{commit}")" != "$(git rev-parse HEAD)" ]; then
          echo "::error::$tag exists but is not at HEAD; a failed release resumes only from its own commit"
          exit 1
        else
          mode=resume
        fi
        first=true
        for other in $(git tag --list 'v*'); do
          if [ "$other" != "$tag" ]; then first=false; fi
        done
        case "$v" in
          *-*) pre=${v#*-}; dist=${pre%%.*} ;;
          *) dist=latest ;;
        esac
        echo "::notice::Release mode: $mode ($tag, npm tag $dist)"
        {
          echo "tag=$tag"
          echo "mode=$mode"
          echo "first-release=$first"
          echo "dist-tag=$dist"
        } >> "$GITHUB_OUTPUT"

  release:author:
    desc: "CI only: Set the git author to the github-actions bot."
    cmds:
      - |
        git config user.name "github-actions[bot]"
        git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

  release:tag:
    desc: "CI only: Tag HEAD with TAG."
    cmds:
      - git tag "$TAG"

  release:verify:
    desc: "CI only: Rebuild dist/ from the tagged source, then pack and verify the publishable projects; fails when no tarball was written."
    cmds:
      - |
        pnpm exec nx run-many -t pack verify-dist verify-consumer -p tag:publishable
        if ! ls dist/tarballs/*.tgz >/dev/null 2>&1; then
          echo "::error::No tarball in dist/tarballs: give each publishable project the pack and verify-dist targets"
          exit 1
        fi

  release:push:
    desc: "CI only: Push the tag TAG, and nothing else."
    cmds:
      - git push origin "refs/tags/$TAG"

  release:github:
    desc: "CI only: Create the GitHub Release for TAG as a draft, from the tarballs and release-notes.mjs."
    cmds:
      - |
        tag="$TAG"
        # A draft is what an earlier run left behind (published means released mode); keeps the tag.
        if gh release view "$tag" --json isDraft --jq .isDraft >/dev/null 2>&1; then
          gh release delete "$tag" --yes
        fi
        node tools/ci/release-notes.mjs "${tag#v}" > "$RUNNER_TEMP/notes.md"
        gh release create "$tag" dist/tarballs/*.tgz --verify-tag --title "$tag" --notes-file "$RUNNER_TEMP/notes.md" --draft

  release:publish:
    desc: "CI only: Publish to npm under DIST_TAG; FIRST_RELEASE_FLAG holds the flag, or nothing."
    cmds:
      - pnpm exec nx release publish --tag="$DIST_TAG" --excludeTaskDependencies $FIRST_RELEASE_FLAG

  release:finalize:
    desc: "CI only: Publish the draft GitHub Release for TAG, once npm has the version."
    cmds:
      - gh release edit "$TAG" --draft=false

  release:latest:
    desc: "CI only: Move the rolling latest release to TAG."
    cmds:
      - |
        # Skip when the remote "latest" tag already sits on this tag's commit and
        # the release carries the same assets. (targetCommitish is a branch name,
        # so the tag's ref is what records the commit.)
        list='[.assets[].name] | sort | join(",")'
        want=$(git rev-parse "$TAG^{commit}")
        refs=$(git ls-remote origin refs/tags/latest 'refs/tags/latest^{}')
        have=$(echo "$refs" | awk '/\^\{\}$/ {p=$1} {l=$1} END {print p ? p : l}')
        if [ "$have" = "$want" ] &&
          [ "$(gh release view latest --json assets --jq "$list")" = "$(gh release view "$TAG" --json assets --jq "$list")" ]; then
          echo "::notice::latest already points at $TAG"
          exit 0
        fi
        # Released mode has no local tarballs; fetch them from the published release.
        if ! ls dist/tarballs/*.tgz >/dev/null 2>&1; then
          gh release download "$TAG" --dir dist/tarballs --pattern '*.tgz'
        fi
        gh release delete latest --yes --cleanup-tag || true
        git tag -f latest
        git push origin latest --force
        gh release create latest dist/tarballs/*.tgz --title "Latest" --notes "Rolling pointer to $TAG"

  verify-release:
    desc: "CI only: Install what consumers download, the tarballs of the release TAG."
    cmds:
      - |
        gh release download "$TAG" --dir dist/tarballs --pattern '*.tgz'
        pnpm exec nx run-many -t verify-consumer --excludeTaskDependencies
{% endif %}{% if docs %}
  docs:site:
    desc: "CI only: Build Compodoc and Storybook and assemble them under the MkDocs site in .docs-site."
    cmds:
      - pnpm exec nx run-many -t compodoc build-storybook
      - node tools/ci/assemble-site.mjs .docs-site
{% endif %}{% endif %}{% if not node_lib %}
  plan:
    desc: "CI only: Print the plan's outputs for $GITHUB_OUTPUT."
    silent: true
    cmds:
      - |
        set -euo pipefail
        base="${BASE:-}"
        if [ "${EVENT_NAME:-}" = push ]; then
          base=$(gh run list --workflow ci.yml --branch main --event push --status success --limit 1 --json headSha --jq '.[0].headSha // ""')
        fi
        {{.DEVOPS}} plan "$base"

{% if not workspace %}  validate:
    desc: "CI only: Run the repository-wide checks — lint, typecheck{% if docs %}, docs build{% endif %}; `test` runs the tests."
    cmds:
      - task: :lint
      - task: :typecheck
{% if docs %}      - task: :docs:build
{% endif %}{% for ref in extra_refs.get("validate", []) %}      - task: :[[ ref ]]
{% endfor %}
  test:
    desc: "CI only: Run the repository's tests (the plan's one member)."
    cmds:
      - task: :test

{% else %}{% if internal_ranges_enabled %}  internal-ranges:
    desc: "CI only: Check that members depend on each other by range, not by exact pin."
    silent: true
    cmds:
      - "{{.DEVOPS}} requirements"

{% endif %}  adapters:
    desc: "CI only: Check each package's declared adapters."
    silent: true
    cmds:
      - "{{.DEVOPS}} adapters"

  test:
    desc: "CI only: Lint, typecheck and test one member (-- <package>, with PACKAGE_DIR)."
    cmds:
      - uv run --directory "$PACKAGE_DIR" --package {{.CLI_ARGS}} ruff check src $(test -d "$PACKAGE_DIR/tests" && echo tests)
      - uv run --directory "$PACKAGE_DIR" --package {{.CLI_ARGS}} pyright src
      - uv run --directory "$PACKAGE_DIR" --package {{.CLI_ARGS}} pytest -q $PYTEST_ARGS

{% endif %}  integration:
    desc: "CI only: A member's tests against the service containers it declares (-- <package>)."
    silent: true
    cmds:
      - '{{.DEVOPS}} integration {{.CLI_ARGS}}'

  smoke:
    desc: "CI only: Install one extra from the built wheel and import it (-- <package> [extra])."
    silent: true
    cmds:
      - '{{.DEVOPS}} smoke {{.CLI_ARGS}} "${EXTRA:-}"'

  suites:
    desc: "CI only: Run one workspace-wide pytest suite."
    cmds:
      - uv run pytest $SUITE_ARGS

  verify-release:
    desc: "CI only: Install the release from {% if release == "pypi" %}PyPI{% else %}its git tag{% endif %}, outside the repository, and import it{% if not workspace %} (-- <tag>){% endif %}."
    cmds:
      - '{{.DEVOPS}} verify-release --source [[ "pypi" if release == "pypi" else "git" ]] {{.CLI_ARGS}}'
{% if workspace %}
  release:build:
    desc: "CI only: Build the releasable packages and their SBOMs into dist/<package>/, prerequisites first."
    cmds:
      - |
        set -euo pipefail
        mapfile -t names < <(jq -r '.[]' <<<"$SELECTED")
        releasable="$({{.DEVOPS}} releasable ok "${names[@]}")"
        built=0
        for name in $releasable; do
          version="$(uv version --package "$name" --short)"
          tag="$name-v$version"
{% if release == "pypi" %}          if [ "${TESTPYPI:-}" = true ]; then
            uv build --package "$name" --out-dir "dist/$name"
            uvx --from twine==6.2.0 twine check --strict dist/"$name"/*.whl dist/"$name"/*.tar.gz
            uv export --format cyclonedx1.5 --frozen --no-default-groups --package "$name" -q -o "dist/$name/$name.cdx.json"
            built=$((built + 1))
            continue
          fi
{% endif %}          state="$({{.DEVOPS}} release-state "$tag")"
          if grep -qx 'should-release=false' <<<"$state"; then
            echo "Release $tag is already published, skipping."
            continue
          fi
          if grep -qx 'tagged=true' <<<"$state"; then
            git fetch --no-tags origin "refs/tags/$tag"
            worktree=$(mktemp -d)
            git worktree add --detach "$worktree" FETCH_HEAD
            uv build --directory "$worktree" --package "$name" --out-dir "$GITHUB_WORKSPACE/dist/$name"
{% if release == "pypi" %}            uvx --from twine==6.2.0 twine check --strict dist/"$name"/*.whl dist/"$name"/*.tar.gz
{% endif %}            uv export --format cyclonedx1.5 --frozen --no-default-groups --directory "$worktree" --package "$name" -q -o "$GITHUB_WORKSPACE/dist/$name/$name.cdx.json"
            git worktree remove "$worktree"
          else
            uv build --package "$name" --out-dir "dist/$name"
{% if release == "pypi" %}            uvx --from twine==6.2.0 twine check --strict dist/"$name"/*.whl dist/"$name"/*.tar.gz
{% endif %}            uv export --format cyclonedx1.5 --frozen --no-default-groups --package "$name" -q -o "dist/$name/$name.cdx.json"
          fi
          built=$((built + 1))
        done
        printf 'built=%s\n' "$built" >> "$GITHUB_OUTPUT"

{% if release == "pypi" %}  release:sign:
    desc: "CI only: Sign each built wheel and sdist, writing a PEP 740 *.publish.attestation beside it."
    cmds:
      - |
        set -euo pipefail
        for file in dist/*/*.whl dist/*/*.tar.gz; do
          [ -e "$file" ] || continue
          for attempt in $(seq 1 5); do
            if uvx pypi-attestations==0.0.30 sign "$file"; then
              break
            fi
            echo "::warning::Signing $file failed on attempt $attempt."
            if [ "$attempt" -eq 5 ]; then
              exit 1
            fi
            sleep 20
          done
        done

{% endif %}  release:publish:
    desc: "CI only: Publish a GitHub release for each package release:build built, prerequisites first."
    cmds:
      - |
        set -euo pipefail
        mapfile -t names < <(jq -r '.[]' <<<"$SELECTED")
        releasable="$({{.DEVOPS}} releasable ok "${names[@]}")"
        for name in $releasable; do
          version="$(uv version --package "$name" --short)"
          tag="$name-v$version"
          if [ ! -d "dist/$name" ]; then
            echo "Nothing to publish for $tag, skipping."
            continue
          fi
{% if release == "pypi" %}          upload=pypi
          if [ "${TESTPYPI:-}" = true ]; then upload=testpypi; fi
{% endif %}          dir="$(uv workspace dir --package "$name")"
          notes="$(mktemp)"
          {{.DEVOPS}} notes "$dir/CHANGELOG.md" "$version" > "$notes"
          {{.DEVOPS}} release-publish "$tag" --title "$name v$version" --target "$GITHUB_SHA" --notes-file "$notes" {% if release == "pypi" %}--upload "$upload" {% endif %}dist/"$name"/*
        done

{% if docs %}
  docs:publish:
    desc: "CI only: Deploy each released package's versioned site, then build the root site (SITE_DIR) with packages/ merged in."
    cmds:
      - |
        set -euo pipefail
        git config user.name "github-actions[bot]"
        git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
        {{.DEVOPS}} released | while read -r _ dir _ version; do
          config="$dir/mkdocs.yml"
          [ -f "$config" ] || continue
          first=$(uv run --group docs mike list --deploy-prefix "$dir" -F "$config" 2>/dev/null | wc -l || true)
          uv run --group docs mike deploy --deploy-prefix "$dir" -F "$config" \
            --alias-type copy --update-aliases --push "${version%.*}" latest
          if [ "$first" -eq 0 ]; then
            uv run --group docs mike set-default --deploy-prefix "$dir" -F "$config" --push latest
          fi
        done
      - '{{.TASK_EXE}} docs:build -- "$SITE_DIR"'
      - |
        if git fetch origin gh-pages; then
          git archive FETCH_HEAD packages | tar -x -C "$SITE_DIR"
        fi
{% endif %}
{% endif %}{% endif %}