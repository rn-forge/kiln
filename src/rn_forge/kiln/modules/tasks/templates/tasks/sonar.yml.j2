version: "3"

# The developer's local SonarCloud scan, rendered only when `[ci] sonar` is on.
# Not a CI task: no workflow calls it, so it is not under `ci:`.

vars:
  DEVOPS: '[[ devops ]]'

tasks:
  local:
    desc: Run the coverage tests and scan the checked-out branch on SonarCloud, awaiting the quality gate. Needs SONAR_TOKEN and sonar-scanner on PATH; pass --dry-run after -- to print the commands.
    cmds:
      - '{{.DEVOPS}} sonar-local {{.CLI_ARGS}}'
