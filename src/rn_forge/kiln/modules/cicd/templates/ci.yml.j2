# Generated by kiln [[ kiln_version ]] from .rn-forge/kiln/config.toml — do not edit; run 'kiln apply'
name: CI

{% if workspace %}# validate → plan → verify, postgres, smoke, suites → sonar → release → external-install, docs.
#
# validate: the repository-wide checks (lint, adapters, docs build), once.
# plan:     reads the uv workspace and selects the changed packages and their
#           dependents, as the outputs every later job reads.
# verify:   one job per selected package — lint, typecheck and test that member.
# postgres, smoke, suites: the jobs a package or the workspace declares — tests
#           against PostgreSQL, one extra installed alone, workspace-wide pytest.
# sonar:    the scan, once verify, postgres and smoke have passed.
# release:  the selected packages whose checks all passed, in dependency order,
#           each on its own `<package>-v<version>` tag.
# external-install: installs each new tag from git, outside the workspace.
{% if docs %}# docs:     deploys each released package's versioned site and the root site to Pages.
{% endif %}{% else %}# validate → sonar → release.
{% endif %}#
# Every step goes through `task`; `kiln doctor`'s ci-entrypoint rule fails the
# build if a step invokes uv/pytest/ruff/pyright/mkdocs/kiln directly. kiln runs
# here only as the version `[kiln] ref` pins, read-only, through
# `task validate`: it checks the tree against the committed
# .rn-forge/kiln/state.json and never runs `kiln apply`.
#
# The repeated toolchain setup lives in .github/actions/setup, committed beside
# this file. Each job checks out first: GitHub can only run a local action from
# the checked-out tree. Every `uses:` is pinned to a commit SHA with the version
# in a trailing comment. Pins move in kiln (cicd/pins.toml), not here; Dependabot
# (.github/dependabot.yml, also generated) watches only the repository's own
# actions and its uv dependencies.

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
  workflow_dispatch: {}

permissions:
  contents: read

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

env:
  # CI resolves the committed lock and never rewrites it. Without this a stale
  # uv.lock passes CI against a resolution nobody committed.
  UV_LOCKED: "1"

jobs:
  validate:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    permissions:
      contents: read
    steps:
      - name: Checkout
        uses: [[ pins["checkout"].uses ]]@[[ pins["checkout"].sha ]] # [[ pins["checkout"].version ]]
        with:
          persist-credentials: false

      - name: Set up the toolchain
        uses: ./.github/actions/setup # zizmor: ignore[self-repository] actionlint rejects the $/ form
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}

      - name: Install dependencies
        run: task setup

      - name: Validate
        run: {% if workspace %}task lint{% else %}task validate{% endif %}
        env:
          KILN_DOCTOR_FULL: {% if doctor_full == "every-run" %}"1"{% else %}${{ ((github.event_name == 'push' && github.ref_name == github.event.repository.default_branch) || github.event_name == 'workflow_dispatch') && '1' || '' }}{% endif %}
{% if workspace %}
      - name: Check adapters
        run: task ci:adapters
{% if docs %}
      - name: Build docs
        run: task docs:build
{% endif %}{% endif %}
  # Fails a pull request that adds a dependency with a known vulnerability, from
  # GitHub's dependency graph. Skipped on a push, which `ci-ok` treats as a pass.
  dependency-review:
    needs: validate
    if: ${{ github.event_name == 'pull_request' }}
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: read
    steps:
      - name: Checkout
        uses: [[ pins["checkout"].uses ]]@[[ pins["checkout"].sha ]] # [[ pins["checkout"].version ]]
        with:
          persist-credentials: false

      - name: Review dependency changes
        uses: [[ pins["dependency-review"].uses ]]@[[ pins["dependency-review"].sha ]] # [[ pins["dependency-review"].version ]]
{% if workspace %}
  plan:
    needs: validate
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions:
      contents: read
      actions: read
    outputs:
{% for key in plan_keys %}      [[ key ]]: ${{ steps.plan.outputs.[[ key ]] }}
{% endfor %}    steps:
      - name: Checkout
        uses: [[ pins["checkout"].uses ]]@[[ pins["checkout"].sha ]] # [[ pins["checkout"].version ]]
        with:
          fetch-depth: 0
          persist-credentials: false

      - name: Set up the toolchain
        uses: ./.github/actions/setup # zizmor: ignore[self-repository] actionlint rejects the $/ form
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}

      - name: Plan
        id: plan
        env:
          GH_TOKEN: ${{ github.token }}
          EVENT_NAME: ${{ github.event_name }}
          BASE: ${{ github.event_name == 'pull_request' && github.event.pull_request.base.sha || '' }}
        run: task ci:plan >> "$GITHUB_OUTPUT"

  verify:
    name: verify (${{ matrix.name }})
    needs: [validate, plan]
    if: ${{ !cancelled() && needs.validate.result == 'success' && needs.plan.outputs.packages != '[]' }}
    runs-on: ubuntu-latest
    timeout-minutes: 20
    permissions:
      contents: read
    strategy:
      fail-fast: false
      matrix:
        include: ${{ fromJSON(needs.plan.outputs.packages) }}
    steps:
      - name: Checkout
        uses: [[ pins["checkout"].uses ]]@[[ pins["checkout"].sha ]] # [[ pins["checkout"].version ]]
        with:
          persist-credentials: false

      - name: Set up the toolchain
        uses: ./.github/actions/setup # zizmor: ignore[self-repository] actionlint rejects the $/ form
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}

      - name: Install dependencies
        run: task setup

      - name: Verify
        env:
          PACKAGE_DIR: ${{ matrix.dir }}
          PYTEST_ARGS: ${{ needs.plan.outputs.pytest-args }}
        run: task ci:verify -- ${{ matrix.name }}

      - name: Record the check
        run: mkdir ok && touch "ok/${{ matrix.name }}.verify"

      - name: Upload the check marker
        uses: [[ pins["upload-artifact"].uses ]]@[[ pins["upload-artifact"].sha ]] # [[ pins["upload-artifact"].version ]]
        with:
          name: ok-${{ matrix.name }}.verify
          path: ok/
          retention-days: 1

  # For a package with `[tool.workspace-ci.postgres]`: its tests again, with the
  # DSN in the environment variable it names.
  postgres:
    name: postgres (${{ matrix.name }})
    needs: [validate, plan]
    if: ${{ !cancelled() && needs.validate.result == 'success' && needs.plan.outputs.postgres != '[]' }}
    runs-on: ubuntu-latest
    timeout-minutes: 20
    permissions:
      contents: read
    strategy:
      fail-fast: false
      matrix:
        include: ${{ fromJSON(needs.plan.outputs.postgres) }}
    services:
      postgres:
        image: postgres:17
        env:
          POSTGRES_USER: ci
          POSTGRES_PASSWORD: ci
          POSTGRES_DB: ci
        ports:
          - 5432:5432
        options: >-
          --health-cmd "pg_isready -U ci"
          --health-interval 5s
          --health-timeout 5s
          --health-retries 10
    steps:
      - name: Checkout
        uses: [[ pins["checkout"].uses ]]@[[ pins["checkout"].sha ]] # [[ pins["checkout"].version ]]
        with:
          persist-credentials: false

      - name: Set up the toolchain
        uses: ./.github/actions/setup # zizmor: ignore[self-repository] actionlint rejects the $/ form
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}

      - name: Install dependencies
        run: task setup

      - name: Test against PostgreSQL
        env:
          PACKAGE_DIR: ${{ matrix.dir }}
          DSN_VAR: ${{ matrix.env }}
          PYTEST_ARGS: ${{ needs.plan.outputs.pytest-args }}
        run: task ci:postgres -- ${{ matrix.name }}

      - name: Record the check
        run: mkdir ok && touch "ok/${{ matrix.name }}.postgres"

      - name: Upload the check marker
        uses: [[ pins["upload-artifact"].uses ]]@[[ pins["upload-artifact"].sha ]] # [[ pins["upload-artifact"].version ]]
        with:
          name: ok-${{ matrix.name }}.postgres
          path: ok/
          retention-days: 1

  # Every other job syncs everything, which hides an extra that forgets a
  # dependency another extra brings. Each extra is installed alone, from the
  # built wheel's metadata, into a clean venv and imported.
  smoke:
    name: smoke (${{ matrix.marker }})
    needs: [validate, plan]
    if: ${{ !cancelled() && needs.validate.result == 'success' && needs.plan.outputs.smoke != '[]' }}
    runs-on: ubuntu-latest
    timeout-minutes: 20
    permissions:
      contents: read
    strategy:
      fail-fast: false
      matrix:
        include: ${{ fromJSON(needs.plan.outputs.smoke) }}
    steps:
      - name: Checkout
        uses: [[ pins["checkout"].uses ]]@[[ pins["checkout"].sha ]] # [[ pins["checkout"].version ]]
        with:
          persist-credentials: false

      - name: Set up the toolchain
        uses: ./.github/actions/setup # zizmor: ignore[self-repository] actionlint rejects the $/ form
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}

      - name: Install and import
        env:
          EXTRA: ${{ matrix.extra }}
        run: task ci:smoke -- ${{ matrix.name }}

      - name: Record the check
        run: mkdir ok && touch "ok/${{ matrix.marker }}"

      - name: Upload the check marker
        uses: [[ pins["upload-artifact"].uses ]]@[[ pins["upload-artifact"].sha ]] # [[ pins["upload-artifact"].version ]]
        with:
          name: ok-${{ matrix.marker }}
          path: ok/
          retention-days: 1

  # Workspace-wide pytest runs from the root `[tool.workspace-ci.suites]`.
  suites:
    name: suite (${{ matrix.name }})
    needs: [validate, plan]
    if: ${{ !cancelled() && needs.validate.result == 'success' && needs.plan.outputs.suites != '[]' }}
    runs-on: ubuntu-latest
    timeout-minutes: 20
    permissions:
      contents: read
    strategy:
      fail-fast: false
      matrix:
        include: ${{ fromJSON(needs.plan.outputs.suites) }}
    steps:
      - name: Checkout
        uses: [[ pins["checkout"].uses ]]@[[ pins["checkout"].sha ]] # [[ pins["checkout"].version ]]
        with:
          persist-credentials: false

      - name: Set up the toolchain
        uses: ./.github/actions/setup # zizmor: ignore[self-repository] actionlint rejects the $/ form
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}

      - name: Install dependencies
        run: task setup

      - name: Run the suite
        env:
          SUITE_ARGS: ${{ matrix.args }}
        run: task ci:suite
{% endif %}{% if sonar %}
  sonar:
{% if workspace %}    needs: [validate, verify, postgres, smoke]
    # The scan runs on a same-repository pull request and on main, nowhere else.
    # A fork's pull request cannot see SONAR_TOKEN, and SonarQube Cloud's free
    # plan keeps no readable result for any other branch, so the quality-gate
    # wait fails there. Validation stays required; the scan is skipped.
    if: ${{ !cancelled() && !contains(needs.*.result, 'failure') && ((github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name == github.repository) || (github.event_name != 'pull_request' && github.ref == 'refs/heads/main')) }}
{% else %}    needs: validate
    # The scan runs on a same-repository pull request and on main, nowhere else.
    # A fork's pull request cannot see SONAR_TOKEN, and SonarQube Cloud's free
    # plan keeps no readable result for any other branch, so the quality-gate
    # wait fails there. Validation stays required; the scan is skipped.
    if: >-
      (github.event_name == 'pull_request' &&
      github.event.pull_request.head.repo.full_name == github.repository) ||
      (github.event_name != 'pull_request' && github.ref == 'refs/heads/main')
{% endif %}    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: read
      pull-requests: read
    steps:
      - name: Checkout
        uses: [[ pins["checkout"].uses ]]@[[ pins["checkout"].sha ]] # [[ pins["checkout"].version ]]
        with:
          fetch-depth: 0
          persist-credentials: false

      - name: Set up the toolchain
        uses: ./.github/actions/setup # zizmor: ignore[self-repository] actionlint rejects the $/ form
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}

      - name: Install dependencies
        run: task setup

      # A push or dispatch names its branch (main, by the job's `if`), so the
      # analysis lands on it explicitly. A pull request keeps the scanner's own
      # detection. A tag has no branch to analyse.
      - name: Resolve the analysis target
        id: target
        env:
          EVENT_NAME: ${{ github.event_name }}
          REF_TYPE: ${{ github.ref_type }}
          REF_NAME: ${{ github.ref_name }}
        run: |
          set -euo pipefail
          if [ "$EVENT_NAME" = pull_request ]; then
            printf 'branch-arg=\n' >> "$GITHUB_OUTPUT"
          elif [ "$REF_TYPE" = tag ]; then
            printf '%s\n' "Sonar analyses branches, not tags: $REF_NAME" >&2
            exit 1
          else
            printf 'branch-arg=-Dsonar.branch.name=%s\n' "$REF_NAME" >> "$GITHUB_OUTPUT"
          fi

      - name: Test with coverage
        run: task test:coverage

      # `sonar.qualitygate.wait` is what makes the gate a gate: without it the
      # job succeeds on *submitting* the analysis, and a release can ship while
      # Sonar is still deciding it failed.
      - name: SonarQube scan
        uses: [[ pins["sonarqube-scan"].uses ]]@[[ pins["sonarqube-scan"].sha ]] # [[ pins["sonarqube-scan"].version ]]
        env:
          SONAR_TOKEN: ${{ secrets.SONAR_TOKEN }}
        with:
          args: >
            -Dsonar.qualitygate.wait=true
            ${{ steps.target.outputs.branch-arg }}
{% endif %}{% if release == "tag-exists" and workspace %}
  # Tags created with GITHUB_TOKEN start no workflow, so every release is created
  # here, prerequisites first, only on a push to the default branch and after
  # the quality gate. A failed check blocks its package and every selected
  # package that depends on it; with Sonar on, it blocks the whole run.
  release:
    needs: [validate, plan, verify, postgres, smoke{% if sonar %}, sonar{% endif %}]
    if: ${{ !cancelled() && needs.validate.result == 'success' && needs.plan.outputs.release-order != '[]' && github.event_name == 'push' && github.ref == 'refs/heads/main'{% if sonar %} && needs.sonar.result == 'success'{% endif %} }}
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: write
      id-token: write
      attestations: write
    steps:
      - name: Checkout
        uses: [[ pins["checkout"].uses ]]@[[ pins["checkout"].sha ]] # [[ pins["checkout"].version ]]
        with:
          persist-credentials: false

      - name: Set up the toolchain
        uses: ./.github/actions/setup # zizmor: ignore[self-repository] actionlint rejects the $/ form
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}

      - name: Download the check markers
        uses: [[ pins["download-artifact"].uses ]]@[[ pins["download-artifact"].sha ]] # [[ pins["download-artifact"].version ]]
        with:
          pattern: ok-*
          merge-multiple: true
          path: ok/

      - name: Build releases
        id: build
        env:
          GH_TOKEN: ${{ github.token }}
          SELECTED: ${{ needs.plan.outputs.release-order }}
        run: task ci:release-build

      # Attested before anything is published, because the release, not the
      # tag, is the record: a failure here leaves nothing published, and a
      # rerun attests again. Skipped when every package was already released.
      - name: Generate provenance
        if: steps.build.outputs.built != '0'
        uses: [[ pins["attest"].uses ]]@[[ pins["attest"].sha ]] # [[ pins["attest"].version ]]
        with:
          subject-path: |
            dist/*/*.whl
            dist/*/*.tar.gz
            dist/*/*.cdx.json

      - name: Publish releases
        env:
          GH_TOKEN: ${{ github.token }}
          SELECTED: ${{ needs.plan.outputs.release-order }}
        run: task ci:release-publish

  # Package checks resolve internal dependencies from the workspace, which
  # never proves a tag installs on its own.
  external-install:
    needs: [release]
    if: ${{ !cancelled() && needs.release.result == 'success' && github.event_name == 'push' && github.ref_name == 'main' }}
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: read
    steps:
      - name: Checkout
        uses: [[ pins["checkout"].uses ]]@[[ pins["checkout"].sha ]] # [[ pins["checkout"].version ]]
        with:
          fetch-depth: 0
          persist-credentials: false

      - name: Set up the toolchain
        uses: ./.github/actions/setup # zizmor: ignore[self-repository] actionlint rejects the $/ form
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}

      - name: Verify remote tags and clean installs
        env:
          REPOSITORY_URL: ${{ github.server_url }}/${{ github.repository }}
        run: task ci:external-install
{% elif release == "tag-exists" %}
  release:
    needs: [validate{% if sonar %}, sonar{% endif %}]
    if: github.event_name == 'push' && github.ref_name == 'main'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: write
      id-token: write
      attestations: write
    steps:
      - name: Checkout
        uses: [[ pins["checkout"].uses ]]@[[ pins["checkout"].sha ]] # [[ pins["checkout"].version ]]
        with:
          persist-credentials: false

      - name: Set up the toolchain
        uses: ./.github/actions/setup # zizmor: ignore[self-repository] actionlint rejects the $/ form
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}

      - name: Read version
        id: version
        run: |
          version="$(task version)"
          printf 'version=%s\n' "$version" >> "$GITHUB_OUTPUT"

      # The *release* is the record of what shipped, not the tag. Checking
      # the tag instead would make a half-finished publish permanent: the tag
      # would exist, the release would not, and every rerun would skip.
      - name: Check whether this version has been released
        id: check
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          VERSION: ${{ steps.version.outputs.version }}
        run: |
          tag="v$VERSION"
          draft=$(gh release view "$tag" --json isDraft --jq .isDraft 2>/dev/null || true)
          if [ "$draft" = false ]; then
            printf '%s\n' "Release $tag already published; nothing to do."
            printf 'should-release=false\n' >> "$GITHUB_OUTPUT"
            exit 0
          fi
          printf 'should-release=true\n' >> "$GITHUB_OUTPUT"
          printf 'draft=%s\n' "$([ "$draft" = true ] && echo true || echo false)" >> "$GITHUB_OUTPUT"
          if [ -n "$(git ls-remote --tags origin "refs/tags/$tag")" ]; then
            printf 'tagged=true\n' >> "$GITHUB_OUTPUT"
          else
            printf 'tagged=false\n' >> "$GITHUB_OUTPUT"
          fi
          printf 'tag=%s\n' "$tag" >> "$GITHUB_OUTPUT"

      # A tag without a published release is a release that failed after
      # tagging; rebuilding from `HEAD` would ship a different commit under
      # that version.
      - name: Check out the tagged source
        if: steps.check.outputs.tagged == 'true'
        env:
          TAG: ${{ steps.check.outputs.tag }}
        run: |
          git fetch --no-tags origin "refs/tags/$TAG:refs/tags/$TAG" && git checkout --detach "$TAG"

      - name: Record the source commit
        id: source
        if: steps.check.outputs.should-release == 'true'
        run: |
          printf 'sha=%s\n' "$(git rev-parse HEAD)" >> "$GITHUB_OUTPUT"

      - name: Build
        if: steps.check.outputs.should-release == 'true'
        run: task build

      # Attested before the release is published, because the release, not the
      # tag, is the record: a failure here leaves nothing published.
      - name: Generate provenance
        if: steps.check.outputs.should-release == 'true'
        uses: [[ pins["attest"].uses ]]@[[ pins["attest"].sha ]] # [[ pins["attest"].version ]]
        with:
          subject-path: |
            dist/*.whl
            dist/*.tar.gz
            dist/*.cdx.json

      - name: Delete the leftover draft
        if: steps.check.outputs.draft == 'true'
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          TAG: ${{ steps.check.outputs.tag }}
        run: gh release delete "$TAG" --yes

      # `gh release create` makes the tag itself at `--target`, as part of
      # publishing. Tagging in a separate earlier step is what made a failed
      # upload unrecoverable. On a resumed release the tag already exists and
      # is reused as it is.
      - name: Publish GitHub Release
        if: steps.check.outputs.should-release == 'true'
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          TAG: ${{ steps.check.outputs.tag }}
          SOURCE_SHA: ${{ steps.source.outputs.sha }}
          TAGGED: ${{ steps.check.outputs.tagged }}
        run: |
          set -euo pipefail
          if [ "$TAGGED" = true ]; then
            gh release create "$TAG" dist/*.whl dist/*.tar.gz dist/*.cdx.json --verify-tag --title "$TAG" --generate-notes
          else
            gh release create "$TAG" dist/*.whl dist/*.tar.gz dist/*.cdx.json --target "$SOURCE_SHA" --title "$TAG" --generate-notes
          fi
{% endif %}{% if workspace and docs %}
  # Runs on a push with no package change too, when `release` is skipped. The one
  # job that deploys Pages for a workspace: a root-only deploy landing after it
  # would remove the package sites, so there is no separate docs.yml.
  docs:
    needs: [validate, plan{% if release == "tag-exists" %}, release{% endif %}]
    if: ${{ !cancelled() && needs.validate.result == 'success' && {% if release == "tag-exists" %}needs.release.result != 'failure' && {% endif %}needs.plan.outputs.docs == 'true' && github.event_name == 'push' && github.ref_name == 'main' }}
    runs-on: ubuntu-latest
    timeout-minutes: 15
    concurrency:
      group: pages
      cancel-in-progress: false
    permissions:
      contents: write # mike pushes gh-pages
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Checkout
        uses: [[ pins["checkout"].uses ]]@[[ pins["checkout"].sha ]] # [[ pins["checkout"].version ]]
        with:
          fetch-depth: 0
          persist-credentials: true

      - name: Set up the toolchain
        uses: ./.github/actions/setup # zizmor: ignore[self-repository] actionlint rejects the $/ form
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}

      - name: Install dependencies
        run: task setup

      - name: Deploy the package sites and build the root site
        env:
          SITE_DIR: ${{ runner.temp }}/site
        run: task ci:docs-publish

{% for hook in hooks.docs %}      - name: Run [[ hook ]]
        uses: [[ hook ]] # zizmor: ignore[self-repository] actionlint rejects the $/ form
        env:
          SITE_DIR: ${{ runner.temp }}/site

