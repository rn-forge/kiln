# Generated by kiln [[ kiln_version ]] from .rn-forge/kiln/config.toml — do not edit; run 'kiln apply'
version: "3"

# Repository-wide checks: kiln's own (generated-file drift, the rn-forge
# dependency contract, the task layout) and the tree's Markdown and TOML
# formatting. Everything here is `internal: true`.

tasks:
  lint:markdown:
    desc: Check that every Markdown file in the tree is mdformat-clean.
    internal: true
    cmds:
{% if overrides.get("quality:lint:markdown") %}      - [[ overrides["quality:lint:markdown"] ]]
{% else %}      - uv run --group docs mdformat --check .
{% endif %}
  lint:toml:
    desc: Check that every TOML file in the tree is taplo-formatted.
    internal: true
    cmds:
{% if overrides.get("quality:lint:toml") %}      - [[ overrides["quality:lint:toml"] ]]
{% else %}      - uv run taplo fmt --check
{% endif %}
  lint:generated:
    desc: Fail if a kiln-generated file or block has drifted from the committed state.
    internal: true
    cmds:
{% if overrides.get("quality:lint:generated") %}      - [[ overrides["quality:lint:generated"] ]]
{% else %}      - uv run kiln doctor . --only generated
      - cmd: uv run kiln doctor . --full
        if: '[ -n "{{.KILN_DOCTOR_FULL}}" ]'
{% endif %}
  lint:rn-forge-deps:
    desc: Enforce the archetype's rn-forge dependency contract — required, allowed, pinned.
    internal: true
    cmds:
{% if overrides.get("quality:lint:rn-forge-deps") %}      - [[ overrides["quality:lint:rn-forge-deps"] ]]
{% else %}      - uv run kiln doctor . --only rn-forge-deps
{% endif %}
  lint:task-layout:
    desc: Enforce the wrapper/inner split, non-empty desc, and the validate gate.
    internal: true
    cmds:
{% if overrides.get("quality:lint:task-layout") %}      - [[ overrides["quality:lint:task-layout"] ]]
{% else %}      - uv run kiln doctor . --only task-layout
{% endif %}
  format:markdown:
    desc: Format every Markdown file in the tree with mdformat.
    internal: true
    cmds:
{% if overrides.get("quality:format:markdown") %}      - [[ overrides["quality:format:markdown"] ]]
{% else %}      - uv run --group docs mdformat .
{% endif %}
  format:toml:
    desc: Format every TOML file in the tree with taplo.
    internal: true
    cmds:
{% if overrides.get("quality:format:toml") %}      - [[ overrides["quality:format:toml"] ]]
{% else %}      - uv run taplo fmt
{% endif -%}