on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
{% if node_lib %}  workflow_dispatch:
    inputs:
      use-nx-cloud:
        description: 'Use Nx Cloud distributed CI (leave unchecked to validate on a GitHub runner)'
        required: false
        type: boolean
        default: false
{% elif release == "pypi" %}  workflow_dispatch:
    inputs:
      testpypi:
        type: boolean
        default: false
        description: Upload every package to TestPyPI; no tags or releases
{% else %}  workflow_dispatch: {}
{% endif %}
permissions:
  contents: read

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

env:
  # CI resolves the committed lock and never rewrites it. Without this a stale
  # uv.lock passes CI against a resolution nobody committed.
  UV_LOCKED: "1"

jobs:
  validate:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    permissions:
      contents: read
    steps:
      - name: Checkout
        uses: [[ pins["checkout"].uses ]]@[[ pins["checkout"].sha ]] # [[ pins["checkout"].version ]]
        with:
          persist-credentials: false

      - name: Set up the toolchain
        uses: ./.github/actions/setup # zizmor: ignore[self-repository] actionlint rejects the $/ form
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}

      - name: Install dependencies
        run: task setup

{% if node_lib %}      # The Nx projects are checked by test-cloud or test-local; this job runs the rest.
{% endif %}      - name: Validate
        run: {% if workspace %}task lint{% else %}task ci:validate{% endif %}
        env:
          KILN_DOCTOR_FULL: {% if doctor_full == "every-run" %}"1"{% else %}${{ ((github.event_name == 'push' && github.ref_name == github.event.repository.default_branch) || github.event_name == 'workflow_dispatch') && '1' || '' }}{% endif %}
{% if workspace %}
      - name: Check adapters
        run: task ci:adapters
{% if docs %}
      - name: Build docs
        run: task docs:build
{% endif %}{% endif %}
  # Fails a pull request that adds a dependency with a known vulnerability, from
  # GitHub's dependency graph. Skipped on a push, which `ci-ok` treats as a pass.
  dependency-review:
    needs: validate
    if: ${{ github.event_name == 'pull_request' }}
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: read
    steps:
      - name: Checkout
        uses: [[ pins["checkout"].uses ]]@[[ pins["checkout"].sha ]] # [[ pins["checkout"].version ]]
        with:
          persist-credentials: false

      - name: Review dependency changes
        uses: [[ pins["dependency-review"].uses ]]@[[ pins["dependency-review"].sha ]] # [[ pins["dependency-review"].version ]]
{% if "secret-scan" in check_jobs %}
  # Scans the full git history for leaked secrets (gitleaks, `task ci:secret-scan`). A pull
  # request from a fork cannot be scanned with this checkout, so it is skipped, which
  # `checks-ok` treats as a pass.
  secret-scan:
    if: ${{ github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository }}
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: read
    steps:
      - name: Checkout
        uses: [[ pins["checkout"].uses ]]@[[ pins["checkout"].sha ]] # [[ pins["checkout"].version ]]
        with:
          fetch-depth: 0
          persist-credentials: false

      - name: Set up the toolchain
        uses: ./.github/actions/setup # zizmor: ignore[self-repository] actionlint rejects the $/ form
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}

      - name: Scan the history for secrets
        run: task ci:secret-scan
{% endif %}{% if node_lib %}
  # Distributes lint/test/build/e2e across Nx Cloud agents (.nx/workflows/agents.yaml) when USE_NX_CLOUD=true.
  # This job excludes playwright as they are managed by Nx Cloud agents
  test-cloud:
    needs: validate
    if: ${{ (github.event_name == 'workflow_dispatch' && inputs.use-nx-cloud) || (github.event_name != 'workflow_dispatch' && vars.USE_NX_CLOUD == 'true') }}
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      actions: read
      contents: read
    env:
      NX_CLOUD_ACCESS_TOKEN: ${{ secrets.NX_CLOUD_ACCESS_TOKEN }}
    steps:
      - uses: [[ pins["checkout"].uses ]]@[[ pins["checkout"].sha ]] # [[ pins["checkout"].version ]]
        with:
          filter: tree:0
          fetch-depth: 0
          persist-credentials: false

      - uses: ./.github/actions/setup # zizmor: ignore[self-repository] actionlint rejects the $/ form
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}
          start-ci-run: >-
            --distribute-on="${{ vars.NX_CLOUD_AGENTS || '3' }} linux-medium" --stop-agents-after="lint,test,build,e2e-ci"

      - uses: [[ pins["nx-set-shas"].uses ]]@[[ pins["nx-set-shas"].sha ]] # [[ pins["nx-set-shas"].version ]]

      - run: task ci:test -- lint test build e2e-ci

      # Nx Cloud recommends fixes for failures to help you get CI green faster. Learn more: https://nx.dev/ci/features/self-healing-ci
      - run: pnpm exec nx fix-ci
        if: always()

  # The default path: the pipeline on a GitHub runner, for a repository not on Nx Cloud.
  test-local:
    needs: validate
    if: ${{ (github.event_name == 'workflow_dispatch' && inputs.use-nx-cloud == false) || (github.event_name != 'workflow_dispatch' && vars.USE_NX_CLOUD != 'true') }}
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      actions: read
      contents: read
    steps:
      - uses: [[ pins["checkout"].uses ]]@[[ pins["checkout"].sha ]] # [[ pins["checkout"].version ]]
        with:
          filter: tree:0
          fetch-depth: 0
          persist-credentials: false

      - uses: ./.github/actions/setup # zizmor: ignore[self-repository] actionlint rejects the $/ form
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}

      # Browsers are only needed when some project has an e2e target
      - name: Detect e2e projects
        id: e2e
        run: task ci:test:has-e2e >> "$GITHUB_OUTPUT"

      - name: Cache Playwright browsers
        if: steps.e2e.outputs.has-e2e == 'true'
        uses: [[ pins["cache"].uses ]]@[[ pins["cache"].sha ]] # [[ pins["cache"].version ]]
        id: playwright-cache
        with:
          path: ~/.cache/ms-playwright
          key: playwright-${{ runner.os }}-${{ hashFiles('pnpm-lock.yaml') }}

      - run: task ci:test:playwright
        if: steps.e2e.outputs.has-e2e == 'true' && steps.playwright-cache.outputs.cache-hit != 'true'
      - run: task ci:test:playwright-deps
        if: steps.e2e.outputs.has-e2e == 'true' && steps.playwright-cache.outputs.cache-hit == 'true'

      - uses: [[ pins["nx-set-shas"].uses ]]@[[ pins["nx-set-shas"].sha ]] # [[ pins["nx-set-shas"].version ]]

      - run: task ci:test -- lint test build e2e
{% if sonar %}
