name: Docs

on:
  workflow_call:

permissions:
  contents: read

jobs:{% if node_lib %}
  # Publishes the one Pages site from main after the checks pass: MkDocs, with
  # Compodoc and Storybook assembled under it. deploy-pages replaces the whole
  # site, so every deploy builds all three.
  docs:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      contents: read
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    concurrency:
      group: pages
      cancel-in-progress: false
    steps:
      - uses: [[ pins["checkout"].uses ]]@[[ pins["checkout"].sha ]] # [[ pins["checkout"].version ]]
        with:
          filter: tree:0
          fetch-depth: 0
          persist-credentials: false

      - uses: ./.github/actions/setup # zizmor: ignore[self-repository] actionlint rejects the $/ form
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}

      - name: Build the MkDocs site
        run: task docs:build

      - name: Build Compodoc and Storybook and assemble the site
        run: task ci:docs:site

{% for hook in hooks.docs %}      - name: Run [[ hook ]]
        uses: [[ hook ]] # zizmor: ignore[self-repository] actionlint rejects the $/ form
        env:
          SITE_DIR: .docs-site

{% endfor %}      - uses: [[ pins["configure-pages"].uses ]]@[[ pins["configure-pages"].sha ]] # [[ pins["configure-pages"].version ]]

      - uses: [[ pins["upload-pages-artifact"].uses ]]@[[ pins["upload-pages-artifact"].sha ]] # [[ pins["upload-pages-artifact"].version ]]
        with:
          path: .docs-site
          include-hidden-files: true

      - id: deployment
        uses: [[ pins["deploy-pages"].uses ]]@[[ pins["deploy-pages"].sha ]] # [[ pins["deploy-pages"].version ]]{% elif workspace %}
  # Runs on a push with no package change too, when `release` is skipped. The one
  # job that deploys Pages for a workspace: a root-only deploy landing after it
  # would remove the package sites, so there is no separate docs.yml.
  docs:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    concurrency:
      group: pages
      cancel-in-progress: false
    permissions:
      contents: write # mike pushes gh-pages
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Checkout
        uses: [[ pins["checkout"].uses ]]@[[ pins["checkout"].sha ]] # [[ pins["checkout"].version ]]
        with:
          fetch-depth: 0
          persist-credentials: true # mike pushes gh-pages with this token

      - name: Set up the toolchain
        uses: ./.github/actions/setup # zizmor: ignore[self-repository] actionlint rejects the $/ form
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}

      - name: Install dependencies
        run: task setup

      - name: Deploy the package sites and build the root site
        env:
          SITE_DIR: ${{ runner.temp }}/site
        run: task ci:docs-publish

{% for hook in hooks.docs %}      - name: Run [[ hook ]]
        uses: [[ hook ]] # zizmor: ignore[self-repository] actionlint rejects the $/ form
        env:
          SITE_DIR: ${{ runner.temp }}/site

{% endfor %}      - name: Upload Pages artifact
        uses: [[ pins["upload-pages-artifact"].uses ]]@[[ pins["upload-pages-artifact"].sha ]] # [[ pins["upload-pages-artifact"].version ]]
        with:
          path: ${{ runner.temp }}/site

      - name: Deploy to GitHub Pages
        id: deployment
        uses: [[ pins["deploy-pages"].uses ]]@[[ pins["deploy-pages"].sha ]] # [[ pins["deploy-pages"].version ]]{% else %}
  # The one Pages deploy, after the barrier and the release stages.
  docs:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    concurrency:
      group: pages
      cancel-in-progress: false
    permissions:
      contents: read
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Checkout
        uses: [[ pins["checkout"].uses ]]@[[ pins["checkout"].sha ]] # [[ pins["checkout"].version ]]
        with:
          persist-credentials: false

      - name: Set up the toolchain
        uses: ./.github/actions/setup # zizmor: ignore[self-repository] actionlint rejects the $/ form
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}

      - name: Install dependencies
        run: task setup

      - name: Build docs site
        run: task docs:build -- "$RUNNER_TEMP/site"

{% for hook in hooks.docs %}      - name: Run [[ hook ]]
        uses: [[ hook ]] # zizmor: ignore[self-repository] actionlint rejects the $/ form
        env:
          SITE_DIR: ${{ runner.temp }}/site

{% endfor %}      - name: Upload Pages artifact
        uses: [[ pins["upload-pages-artifact"].uses ]]@[[ pins["upload-pages-artifact"].sha ]] # [[ pins["upload-pages-artifact"].version ]]
        with:
          path: ${{ runner.temp }}/site

      - name: Deploy to GitHub Pages
        id: deployment
        uses: [[ pins["deploy-pages"].uses ]]@[[ pins["deploy-pages"].sha ]] # [[ pins["deploy-pages"].version ]]{% endif %}
