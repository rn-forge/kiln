# Generated by kiln [[ kiln_version ]] from .rn-forge/kiln/config.toml — do not edit; run 'kiln apply'
version: "3"

# The only entrypoint. Nobody — human, agent or CI — invokes `uv`, `pytest`,
# `ruff`, `pyright`, `mkdocs` or `kiln` directly; `kiln doctor --only ci-entrypoint`
# enforces that for every workflow file.
#
# This file holds wrappers only: every task below is a list of calls into
# tasks/*.yml. Anything that shells out lives in the namespace file that owns
# it. Namespaces whose public name is already correct (docs:*) are reached
# through the include directly and carry no wrapper here.
#
# The vocabulary is fixed; see .rn-forge/kiln/standard.md.

env:
  # Keeping the uv cache inside the repo avoids competing with other checkouts
  # for a shared cache dir. Tasks that must not share it (packaging) override
  # this locally.
  UV_CACHE_DIR: .uv-cache

includes:
  quality: tasks/quality.yml
{% if docs %}  docs: tasks/docs.yml
{% endif %}  workspace: tasks/workspace.yml
{% if web %}  api: tasks/api.yml
{% endif %}{% if web_app %}  web: tasks/web.yml
{% endif %}{% for include in includes %}  [[ include.namespace ]]: [[ include.taskfile ]]
{% endfor %}
tasks:
  setup:
    desc: Install the project and its dev + docs dependency groups.
    cmds:
      - task: workspace:install
{% for ref in extra_refs.get("setup", []) %}      - task: [[ ref ]]
{% endfor %}
  validate:
    desc: The aggregate gate — lint, typecheck, test, docs build. Any failure fails.
    cmds:
      - task: lint
      - task: typecheck
      - task: test
{% if docs %}      - task: docs:build
{% endif %}{% for ref in extra_refs.get("validate", []) %}      - task: [[ ref ]]
{% endfor %}
  lint:
    desc: Every lint — Python, generated-file drift, dependencies, imports, task layout, CI entrypoints, docs.
    cmds:
      - task: quality:lint:python
      - task: quality:lint:generated
      - task: quality:lint:rn-forge-deps
      - task: quality:lint:imports
      - task: quality:lint:task-layout
      - task: quality:lint:ci-entrypoint
{% if docs %}      - task: quality:lint:docs
      - task: quality:lint:docs-structure
      - task: quality:lint:docs-nav
{% endif %}      - task: quality:lint:markdown
{% if web_app %}      - task: web:lint
{% endif %}{% for ref in extra_refs.get("lint", []) %}      - task: [[ ref ]]
{% endfor %}
  format:
    desc: Format Python code and Markdown prose in place.
    cmds:
      - task: quality:format:python
      - task: quality:format:markdown
{% for ref in extra_refs.get("format", []) %}      - task: [[ ref ]]
{% endfor %}
  typecheck:
    desc: Static type-check the package in pyright strict mode.
    cmds:
      - task: quality:typecheck:python
{% for ref in extra_refs.get("typecheck", []) %}      - task: [[ ref ]]
{% endfor %}
  test:
    desc: Run the pytest suite.
    cmds:
      - task: quality:test:python
{% if web_app %}      - task: web:test
{% endif %}{% for ref in extra_refs.get("test", []) %}      - task: [[ ref ]]
{% endfor %}
  test:coverage:
    desc: Run the pytest suite with an XML coverage report (used by CI/Sonar).
    cmds:
      - task: quality:test:coverage
{% for ref in extra_refs.get("test:coverage", []) %}      - task: [[ ref ]]
{% endfor %}
  build:
{% if workspace %}    desc: Build one package's wheel and sdist into dist/ (pass -- <package>), or every package's.
{% else %}    desc: Build the wheel and sdist into dist/.
{% endif %}    cmds:
      - task: workspace:build
{% if web_app %}      - task: web:build
{% endif %}{% for ref in extra_refs.get("build", []) %}      - task: [[ ref ]]
{% endfor %}
  version:
{% if workspace %}    desc: Print one package's version (pass -- <package>), or every package's.
{% else %}    desc: Print the package version from pyproject.toml.
{% endif %}    cmds:
      - task: workspace:version
{% for ref in extra_refs.get("version", []) %}      - task: [[ ref ]]
{% endfor %}
  clean:
    desc: Remove build outputs, caches, and the rendered docs site.
    cmds:
      - task: workspace:clean
{% for ref in extra_refs.get("clean", []) %}      - task: [[ ref ]]
{% endfor -%}
