# Generated by kiln [[ kiln_version ]] from .rn-forge/kiln/config.toml — do not edit; run 'kiln apply'
name: Smoke

on:
  workflow_call:
{% if node_lib %}{% else %}    inputs:
      matrix:
        description: The matrix legs, a JSON array, from the plan
        type: string
        required: true
{% endif %}
permissions:
  contents: read

jobs:{% if node_lib %}
  # Runs regardless of which path above executed - the tarball smoke test isn't a
  # validation step, it just needs one of them to have succeeded first.
  smoke:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: read
    steps:
      - uses: [[ pins["checkout"].uses ]]@[[ pins["checkout"].sha ]] # [[ pins["checkout"].version ]]
        with:
          filter: tree:0
          fetch-depth: 0
          persist-credentials: false

      - uses: ./.github/actions/setup # zizmor: ignore[self-repository] actionlint rejects the $/ form
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}

      # Plain `nx pack` (unlike the release path) never stamps workspace:*
      # peers to exact pins, so verify-dist checks the CI tarballs' manifests.
      - name: Pack and verify publishable tarballs
        run: task ci:smoke

      - name: Upload package tarballs
        uses: [[ pins["upload-artifact"].uses ]]@[[ pins["upload-artifact"].sha ]] # [[ pins["upload-artifact"].version ]]
        with:
          name: package-tarballs
          path: dist/tarballs/*.tgz
          retention-days: 14{% else %}
  # Every other job syncs everything, which hides an extra that forgets a
  # dependency another extra brings. Each extra is installed alone, from the
  # built wheel's metadata, into a clean venv and imported.
  smoke:
    name: smoke (${{ matrix.marker }})
    runs-on: ubuntu-latest
    timeout-minutes: 20
    permissions:
      contents: read
    strategy:
      fail-fast: false
      matrix:
        include: ${{ fromJSON(inputs.matrix) }}
    steps:
      - name: Checkout
        uses: [[ pins["checkout"].uses ]]@[[ pins["checkout"].sha ]] # [[ pins["checkout"].version ]]
        with:
          persist-credentials: false

      - name: Set up the toolchain
        uses: ./.github/actions/setup # zizmor: ignore[self-repository] actionlint rejects the $/ form
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}

      - name: Install and import
        env:
          EXTRA: ${{ matrix.extra }}
        run: task ci:smoke -- ${{ matrix.name }}

      - name: Record the check
        run: mkdir ok && touch "ok/${{ matrix.marker }}"

      - name: Upload the check marker
        uses: [[ pins["upload-artifact"].uses ]]@[[ pins["upload-artifact"].sha ]] # [[ pins["upload-artifact"].version ]]
        with:
          name: ok-${{ matrix.marker }}
          path: ok/
          retention-days: 1{% endif %}
