# Generated by kiln [[ kiln_version ]] from .rn-forge/kiln/config.toml — do not edit; run 'kiln apply'
version: "3"

# The frontend's own dev loop, through the pnpm-managed Nx workspace the
# frontend scaffold owns. Public, like `api:*`: `web:dev` is how
# a developer runs the frontend locally, and `web:lint`/`web:test`/`web:build`
# are also called from the root `lint`/`test`/`build` wrappers.

tasks:
  lint:
    desc: Lint the frontend workspace with Nx.
    cmds:
      - pnpm nx run-many -t lint
  test:
    desc: Test the frontend workspace with Nx.
    cmds:
      - pnpm nx run-many -t test
  build:
    desc: Build the frontend workspace with Nx.
    cmds:
      - pnpm nx run-many -t build
  dev:
    desc: Run the frontend dev server.
    cmds:
      - pnpm nx serve [[ web_project ]]
