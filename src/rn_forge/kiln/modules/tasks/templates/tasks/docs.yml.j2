# Generated by kiln [[ kiln_version ]] from .rn-forge/kiln/config.toml — do not edit; run 'kiln apply'
version: "3"

# The documentation site. A public namespace: `task docs:serve` is something a
# developer runs directly while writing prose, so these four verbs are the only
# non-root public tasks the vocabulary allows (see .rn-forge/kiln/standard.md).
# The `lint:*` tasks are the docs checks `docs:lint` runs, internal like
# `quality`'s.

vars:
  MKDOCS_SITE_DIR: [[ site_dir ]]

tasks:
  build:
    desc: Build the MkDocs site into .docs-site/ (or $1 when given).
    cmds:
{% if overrides.get("docs:build") %}      - [[ overrides["docs:build"] ]]
{% else %}      - uv run --group docs mkdocs build --strict --site-dir "{{.CLI_ARGS | default .MKDOCS_SITE_DIR}}"
{% if workspace %}{% for dir in package_dirs %}      - |
        site=$(mktemp -d) && uv run --group docs mkdocs build --strict -f [[ dir ]]/mkdocs.yml --site-dir "$site"; rc=$?; rm -rf "$site"; exit $rc
{% endfor %}{% endif %}{% endif %}
  serve:
    desc: Serve the docs site locally with live reload on http://127.0.0.1:8080.
    cmds:
{% if overrides.get("docs:serve") %}      - [[ overrides["docs:serve"] ]]
{% else %}      - uv run --group docs mkdocs serve -a 127.0.0.1:8080
{% endif %}
  generate:
    desc: Regenerate the docs' derived regions.
    cmds:
{% if overrides.get("docs:generate") %}      - [[ overrides["docs:generate"] ]]
{% else %}      - uv run kiln docs-generate .
{% endif %}
  lint:
    desc: Every docs check — site links and anchors, the area model, the derived regions.
    cmds:
      - task: lint:site
      - task: lint:structure
      - task: lint:generate

  lint:site:
    desc: Check the docs site for broken links, bad anchors, and orphan pages.
    internal: true
    cmds:
{% if overrides.get("docs:lint:site") %}      - [[ overrides["docs:lint:site"] ]]
{% else %}      - uv run kiln doctor . --only docs-site
{% endif %}
  lint:structure:
    desc: Check the docs tree matches the area model declared in docs/_areas.yml.
    internal: true
    cmds:
{% if overrides.get("docs:lint:structure") %}      - [[ overrides["docs:lint:structure"] ]]
{% else %}      - uv run kiln doctor . --only docs-structure
{% endif %}
  lint:generate:
    desc: Check the docs' derived regions are up to date.
    internal: true
    cmds:
{% if overrides.get("docs:lint:generate") %}      - [[ overrides["docs:lint:generate"] ]]
{% else %}      - uv run kiln doctor . --only docs-generate
{% endif -%}
