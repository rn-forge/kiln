; Generated by kiln golden from .rn-forge/kiln/config.toml — do not edit; run 'kiln apply'
;
; The import boundary, in the half of it import-linter can enforce
; (kiln ADR-0002, ADR-0005).
;
; The rule that rn-forge-commons and rn-forge-tooling are the *only* rn-forge
; packages a repo may depend on is NOT here, and cannot be: import-linter
; rejects subpackages of external packages, so `rn_forge.kiln` is not a legal
; forbidden module however the contract is written. That rule is enforced where
; it is actually decidable — at the dependency declaration, by
; `kiln doctor`'s rn-forge-deps rule.
;
; What is enforceable here is the other half of the reuse pattern: a package
; takes its console, CLI and templating surface *from the rn-forge library that
; owns it*, not by depending on the underlying third-party package itself. A
; direct `import typer` in product code is how two kits ended up with two Typer
; floors and two console conventions (F12).
;
; A workspace gets a second contract: its packages are published separately, so
; a silent dependency between them is a release-ordering bug waiting to happen.

[importlinter]
root_packages =
    golden_alpha
    golden_beta
; None of the forbidden packages are installed here. grimp only reaches an
; external package when it is told to, and without this the contract would pass
; by never being evaluated at all.
include_external_packages = True

[importlinter:contract:frameworks-come-from-rn-forge]
name = No workspace package imports a framework or CLI toolkit directly
type = forbidden
source_modules =
    golden_alpha
    golden_beta
forbidden_modules =
    typer
    jinja2
    click
    django
    fastapi
allow_indirect_imports = False

[importlinter:contract:packages-are-independent]
name = Workspace packages do not import each other
type = independence
modules =
    golden_alpha
    golden_beta
