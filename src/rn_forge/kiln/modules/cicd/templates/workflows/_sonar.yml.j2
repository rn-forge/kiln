# Generated by kiln [[ kiln_version ]] from .rn-forge/kiln/config.toml — do not edit; run 'kiln apply'
name: Sonar

on:
  workflow_call:
    secrets:
      SONAR_TOKEN:
        description: The SonarQube Cloud token
        required: true

permissions:
  contents: read

jobs:{% if node_lib %}
  # Scans one tree, so it runs after either path. Skipped for Dependabot and fork
  # pull requests: GitHub sandboxes both (no Actions secrets), so SONAR_TOKEN is
  # not available there; the next push to main still scans the merged code.
  sonar:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: read
      pull-requests: read
    steps:
      - uses: [[ pins["checkout"].uses ]]@[[ pins["checkout"].sha ]] # [[ pins["checkout"].version ]]
        with:
          fetch-depth: 0 # Sonar needs full history, not a shallow clone
          persist-credentials: false

      - uses: ./.github/actions/setup # zizmor: ignore[self-repository] actionlint rejects the $/ form
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}

      - name: Test with coverage
        run: task test:coverage

      - name: Discover the lcov reports
        id: reports
        run: task ci:sonar:reports >> "$GITHUB_OUTPUT"

      - name: SonarQube Cloud Scan
        uses: [[ pins["sonarqube-scan"].uses ]]@[[ pins["sonarqube-scan"].sha ]] # [[ pins["sonarqube-scan"].version ]]
        with:
          # Without qualitygate.wait the job passes on submitting the analysis,
          # so a failed quality gate would never fail CI.
          args: >
            -Dsonar.javascript.lcov.reportPaths=${{ steps.reports.outputs.reports }}
            -Dsonar.qualitygate.wait=true
        env:
          SONAR_TOKEN: ${{ secrets.SONAR_TOKEN }}{% else %}
  sonar:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: read
      pull-requests: read
    steps:
      - name: Checkout
        uses: [[ pins["checkout"].uses ]]@[[ pins["checkout"].sha ]] # [[ pins["checkout"].version ]]
        with:
          fetch-depth: 0
          persist-credentials: false

      - name: Set up the toolchain
        uses: ./.github/actions/setup # zizmor: ignore[self-repository] actionlint rejects the $/ form
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}

      - name: Install dependencies
        run: task setup

      # A push or dispatch names its branch (main, by the job's `if`), so the
      # analysis lands on it explicitly. A pull request keeps the scanner's own
      # detection. A tag has no branch to analyse.
      - name: Resolve the analysis target
        id: target
        env:
          EVENT_NAME: ${{ github.event_name }}
          REF_TYPE: ${{ github.ref_type }}
          REF_NAME: ${{ github.ref_name }}
        run: task ci:sonar:target >> "$GITHUB_OUTPUT"

      - name: Test with coverage
        run: task test:coverage

      # `sonar.qualitygate.wait` is what makes the gate a gate: without it the
      # job succeeds on *submitting* the analysis, and a release can ship while
      # Sonar is still deciding it failed.
      - name: SonarQube scan
        uses: [[ pins["sonarqube-scan"].uses ]]@[[ pins["sonarqube-scan"].sha ]] # [[ pins["sonarqube-scan"].version ]]
        env:
          SONAR_TOKEN: ${{ secrets.SONAR_TOKEN }}
        with:
          args: >
            -Dsonar.qualitygate.wait=true
            ${{ steps.target.outputs.branch-arg }}{% endif %}
