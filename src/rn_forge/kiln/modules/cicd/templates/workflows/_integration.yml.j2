# Generated by kiln [[ kiln_version ]] from .rn-forge/kiln/config.toml — do not edit; run 'kiln apply'
name: Integration

on:
  workflow_call:
    inputs:
      matrix:
        description: The matrix legs, a JSON array, from the plan
        type: string
        required: true

permissions:
  contents: read

jobs:
  # For a package with `[tool.workspace-ci.integration.<service>]` tables: its
  # tests again, with the service containers `task ci:integration` starts around
  # them. A job's `services` cannot vary with the matrix leg, so the task starts
  # them.
  integration:
    name: integration (${{ matrix.name }})
    runs-on: ubuntu-latest
    timeout-minutes: 20
    permissions:
      contents: read
    strategy:
      fail-fast: false
      matrix:
        include: ${{ fromJSON(inputs.matrix) }}
    steps:
      - name: Checkout
        uses: [[ pins["checkout"].uses ]]@[[ pins["checkout"].sha ]] # [[ pins["checkout"].version ]]
        with:
          persist-credentials: false

      - name: Set up the toolchain
        uses: ./.github/actions/setup # zizmor: ignore[self-repository] actionlint rejects the $/ form
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}

      - name: Install dependencies
        run: task setup

      - name: Test against the declared services
        run: task ci:integration -- ${{ matrix.name }}

      - name: Record the check
        run: mkdir ok && touch "ok/${{ matrix.marker }}"

      - name: Upload the check marker
        uses: [[ pins["upload-artifact"].uses ]]@[[ pins["upload-artifact"].sha ]] # [[ pins["upload-artifact"].version ]]
        with:
          name: ok-${{ matrix.marker }}
          path: ok/
          retention-days: 1
