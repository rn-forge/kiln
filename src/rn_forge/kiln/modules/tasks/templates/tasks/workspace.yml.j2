# Generated by kiln [[ kiln_version ]] from .rn-forge/kiln/config.toml — do not edit; run 'kiln apply'
version: "3"

# Cleanup of every toolchain's outputs and caches, reached through `task clean`,
# and the banner that `validate` prints between its steps.

tasks:
  banner:
    desc: Print a separator line naming the step that follows (STEP).
    internal: true
    silent: true
    requires:
      vars: [STEP]
    cmds:
      - printf '\n==== %s ====\n' '{{.STEP}}'

  clean:
    desc: Remove build outputs, tool caches, and the rendered docs site.
    internal: true
    cmds:
{% if overrides.get("workspace:clean") %}      - [[ overrides["workspace:clean"] ]]
{% else %}      - rm -rf dist build [[ site_dir ]] .pytest_cache .ruff_cache .uv-cache .import_linter_cache coverage.xml
      - find . -type d -name __pycache__ -not -path './.venv/*' -exec rm -rf {} +
{% if node %}      - rm -rf .nx{% if web_dir %} [[ web_dir ]]/dist{% endif %}
{% endif %}{% endif -%}
