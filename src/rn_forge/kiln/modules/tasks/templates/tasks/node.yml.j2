# Generated by kiln [[ kiln_version ]] from .rn-forge/kiln/config.toml — do not edit; run 'kiln apply'
version: "3"

# The pnpm-managed Nx toolchain the frontend scaffold owns. Internal — reached
# through the root wrappers, as `python`'s is.
{% if "licenses" in checks %}
vars:
  DEVOPS: '[[ devops ]]'
{% endif %}
tasks:
  install:
    desc: Install the frontend workspace's locked dependencies.
    internal: true
    cmds:
{% if overrides.get("node:install") %}      - [[ overrides["node:install"] ]]
{% else %}      - pnpm install --frozen-lockfile
{% endif %}
  lint:
    desc: Lint the frontend workspace with Nx.
    internal: true
    cmds:
{% if overrides.get("node:lint") %}      - [[ overrides["node:lint"] ]]
{% else %}      - pnpm nx run-many -t lint
{% endif %}
  lint:format:
    desc: Fail if Prettier would reformat a file it owns (everything not ignored by .prettierignore).
    internal: true
    cmds:
{% if overrides.get("node:lint:format") %}      - [[ overrides["node:lint:format"] ]]
{% else %}      - pnpm exec prettier --check .
{% endif %}
  format:
    desc: Format the frontend workspace's TypeScript, HTML, SCSS, JSON and YAML with Prettier.
    internal: true
    cmds:
{% if overrides.get("node:format") %}      - [[ overrides["node:format"] ]]
{% else %}      - pnpm exec prettier --write .
{% endif %}
  lint:audit:
    desc: Fail if a production dependency has a known vulnerability (pnpm audit; needs the network).
    internal: true
    cmds:
      - pnpm audit --prod --audit-level moderate
{% if "licenses" in checks %}
  lint:licenses:
    desc: Fail if a dependency's licence matches the deny list (pnpm licenses).
    internal: true
    # `set -o pipefail`, as in python's `lint:licenses`: a failing `pnpm` must
    # not let the matcher pass on empty input.
    cmds:
      - >-
        set -o pipefail;
        pnpm licenses list --json --prod
        | {{.DEVOPS}} licenses --format pnpm
{% for d in licenses_deny %}        --deny '[[ d ]]'
{% endfor %}{% for i in licenses_ignore_node %}        --ignore '[[ i ]]'
{% endfor %}{% endif %}
  test:
    desc: Test the frontend workspace with Nx.
    internal: true
    cmds:
{% if overrides.get("node:test") %}      - [[ overrides["node:test"] ]]
{% else %}      - pnpm nx run-many -t test
{% endif %}
  build:
    desc: Build the frontend workspace with Nx.
    internal: true
    cmds:
{% if overrides.get("node:build") %}      - [[ overrides["node:build"] ]]
{% else %}      - pnpm nx run-many -t build
{% endif %}
  typecheck:
    desc: Type-check every project through its Angular build.
    internal: true
    cmds:
{% if overrides.get("node:typecheck") %}      - [[ overrides["node:typecheck"] ]]
{% else %}      - pnpm nx run-many -t build
{% endif %}
{% if node_lib %}  version:
    desc: Print the publishable projects' version, or bump it, write its CHANGELOG.md section and format it (pass -- patch|minor|major|x.y.z); the root version task runs it.
    internal: true
    silent: true
    cmds:
      - |
        read_version() {
          node -e '
          const fs = require("node:fs");
          const path = require("node:path");
          const skip = new Set(["node_modules", "dist", ".git", ".nx"]);
          const versions = new Set();
          const walk = (dir) => {
            for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
              const file = path.join(dir, entry.name);
              if (entry.isDirectory()) {
                if (!skip.has(entry.name)) walk(file);
              } else if (entry.name === "project.json") {
                const tags = JSON.parse(fs.readFileSync(file, "utf8")).tags ?? [];
                if (tags.includes("publishable")) {
                  versions.add(JSON.parse(fs.readFileSync(path.join(dir, "package.json"), "utf8")).version);
                }
              }
            }
          };
          walk(".");
          if (versions.size !== 1) {
            console.error("::error::Expected one version across the publishable projects, found: " + ([...versions].join(", ") || "none"));
            process.exit(1);
          }
          console.log([...versions][0]);
          '
        }
        if [ -n "{{.CLI_ARGS}}" ]; then
          pnpm exec nx release version {{.CLI_ARGS}} --git-commit=false --git-tag=false --stage-changes=false
          version="$(read_version)" || exit 1
          first=""; [ -z "$(git tag --list 'v*')" ] && first=" --first-release"
          pnpm exec nx release changelog "$version" --git-commit=false --git-tag=false --stage-changes=false$first
        else
          read_version
        fi
      - task: :quality:format:markdown
        if: '[ -n "{{.CLI_ARGS}}" ]'
{% endif %}
  e2e:
    desc: Run the workspace's end-to-end tests with Nx.
    internal: true
    cmds:
{% if overrides.get("node:e2e") %}      - [[ overrides["node:e2e"] ]]
{% else %}      - pnpm nx run-many -t e2e
{% endif -%}
