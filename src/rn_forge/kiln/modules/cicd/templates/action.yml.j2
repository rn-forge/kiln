# Generated by kiln [[ kiln_version ]] from .rn-forge/kiln/config.toml — do not edit; run 'kiln apply'
name: Set up the toolchain
description: >-
  Install the pinned interpreter and go-task, and nothing else. Every CI job
  starts with these three steps; a composite action is how they stay one copy
  instead of four (kiln ADR-0003).

inputs:
  fetch-depth:
    description: Checkout depth. Sonar needs full history; nothing else does.
    required: false
    default: "1"
  github-token:
    description: Token for setup-task's release lookup, to avoid rate limits.
    required: true

runs:
  using: composite
  steps:
    - name: Checkout
      uses: [[ pins["checkout"].uses ]]@[[ pins["checkout"].sha ]] # [[ pins["checkout"].version ]]
      with:
        fetch-depth: ${{ inputs.fetch-depth }}

    - name: Install uv
      uses: [[ pins["setup-uv"].uses ]]@[[ pins["setup-uv"].sha ]] # [[ pins["setup-uv"].version ]]
      with:
        python-version: "3.14"

    - name: Install go-task
      uses: [[ pins["setup-task"].uses ]]@[[ pins["setup-task"].sha ]] # [[ pins["setup-task"].version ]]
      with:
        version: 3.x
        repo-token: ${{ inputs.github-token }}
