# Generated by kiln [[ kiln_version ]] from .rn-forge/kiln/config.toml — do not edit; run 'kiln apply'
sonar.projectKey=rn-forge_[[ name ]]
sonar.projectName=[[ name ]]
sonar.organization=[[ organization ]]

{% if node_lib %}sonar.sources=libs,apps
sonar.tests=libs,apps
sonar.test.inclusions=**/*.spec.ts
sonar.exclusions=[[ sonar_exclusions | join(",") ]]
{% elif web %}sonar.sources=[[ api_dir ]]/src{% if web_app %},[[ web_dir ]]/src{% endif %}
sonar.tests=[[ api_dir ]]/tests
{% if web_app %}sonar.javascript.lcov.reportPaths=coverage/[[ web_project ]]/lcov.info
{% endif %}{% if sonar_exclusions %}sonar.exclusions=[[ sonar_exclusions | join(",") ]]
{% endif %}{% elif workspace %}sonar.sources={% for package in packages %}packages/[[ package ]]/src{% if not loop.last %},{% endif %}{% endfor %}
sonar.tests={% for package in packages %}packages/[[ package ]]/tests{% if not loop.last %},{% endif %}{% endfor %}
{% if sonar_exclusions %}sonar.exclusions=[[ sonar_exclusions | join(",") ]]
{% endif %}{% else %}sonar.sources=src
sonar.tests=tests
{% if sonar_exclusions %}sonar.exclusions=[[ sonar_exclusions | join(",") ]]
{% endif %}{% endif %}{% if sonar_coverage_exclusions %}sonar.coverage.exclusions=[[ sonar_coverage_exclusions | join(",") ]]
{% endif %}{% if not node_lib %}
sonar.python.version=3.14
sonar.python.coverage.reportPaths=coverage.xml
{% endif %}