# BEGIN rn-forge kiln
; Generated by kiln 0.1.0 from .rn-forge/kiln/config.toml — do not edit inside this block; run 'kiln apply'.
; A contract of this repo's own goes below the END marker, as its own [importlinter:contract:<name>] section.
;
; The import boundary, in the half of it import-linter can enforce (see
; .rn-forge/kiln/standard.md, "The import boundary").
;
; The rule that rn-forge-commons and rn-forge-tooling are the *only* rn-forge
; packages a repo may depend on is NOT here, and cannot be: import-linter
; rejects subpackages of external packages, so `rn_forge.kiln` is not a legal
; forbidden module however the contract is written. That rule is enforced where
; it is actually decidable — at the dependency declaration, by
; `kiln doctor`'s rn-forge-deps rule.
;
; What is enforceable here is the other half of the reuse pattern: a repo takes
; its console, CLI and templating surface *from the rn-forge library that owns
; it*, not by depending on the underlying third-party package itself. A direct
; `import typer` in product code is how two kits ended up with two Typer floors
; and two console conventions.

[importlinter]
root_package = rn_forge.kiln
; None of the forbidden packages are installed here. grimp only reaches an
; external package when it is told to, and without this the contract would pass
; by never being evaluated at all.
include_external_packages = True

[importlinter:contract:frameworks-come-from-rn-forge]
name = rn_forge.kiln imports no framework or CLI toolkit directly
type = forbidden
source_modules =
    rn_forge.kiln
forbidden_modules =
    typer
    jinja2
    click
    django
    fastapi
allow_indirect_imports = False
# END rn-forge kiln

; The second contract is kiln ADR-0006's: `kiln doctor` runs on every CI run, so
; it must not drag the generator in. A module's `checks/` package is the
; render-free half of that module. It names Jinja only, because
; `rn_forge.commons.generation` is a subpackage of an external package and
; cannot be a forbidden module. The engine half of the rule is
; tests/test_checks_are_render_free.py, which imports the checks and asserts
; the engine never loaded. The block above forbids Jinja everywhere today; it has to
; relax for `kiln doctor --full`, which renders, and this contract is what survives
; that.
;
; The third contract keeps a concern module off its siblings: it imports
; `core` and kiln's composition layer, never another concern module.
; `rn_forge.kiln.config` and `rn_forge.kiln.modules.registry` import every
; module, so their edges into the modules are ignored — a path through the
; composer is not a sibling dependency. The four direct edges ignored after
; them existed when the contract landed (kiln S4.7.1); each reads a sibling's
; config section or a helper. Add no fifth: have the composer pass the value
; in instead.

[importlinter:contract:render-free-checks]
name = the render-free checks import no rendering
type = forbidden
source_modules =
    rn_forge.kiln.checks
    rn_forge.kiln.modules.core.checks
    rn_forge.kiln.modules.python.checks
    rn_forge.kiln.modules.tasks.checks
    rn_forge.kiln.modules.cicd.checks
    rn_forge.kiln.modules.docs.checks
    rn_forge.kiln.modules.instructions.checks
forbidden_modules =
    jinja2
allow_indirect_imports = False

[importlinter:contract:concern-modules-are-independent]
name = a concern module imports core, never a sibling
type = independence
modules =
    rn_forge.kiln.modules.python
    rn_forge.kiln.modules.docs
    rn_forge.kiln.modules.tasks
    rn_forge.kiln.modules.cicd
    rn_forge.kiln.modules.instructions
    rn_forge.kiln.modules.frontend
ignore_imports =
    rn_forge.kiln.config -> rn_forge.kiln.modules.**
    rn_forge.kiln.modules.registry -> rn_forge.kiln.modules.**
    rn_forge.kiln.modules.tasks.artifacts -> rn_forge.kiln.modules.docs.config
    rn_forge.kiln.modules.tasks.artifacts -> rn_forge.kiln.modules.python.artifacts
    rn_forge.kiln.modules.instructions.artifacts -> rn_forge.kiln.modules.cicd.config
    rn_forge.kiln.modules.instructions.artifacts -> rn_forge.kiln.modules.docs.config

; kiln reads YAML, TOML and Markdown through rn-forge-commons. A direct
; parser import is how kiln once shipped an undeclared PyYAML (F7.3).
[importlinter:contract:documents-come-from-rn-forge]
name = rn_forge.kiln imports no YAML, TOML or Markdown parser directly
type = forbidden
source_modules =
    rn_forge.kiln
forbidden_modules =
    yaml
    ruamel
    tomlkit
    markdown
    markdown_it
allow_indirect_imports = True
